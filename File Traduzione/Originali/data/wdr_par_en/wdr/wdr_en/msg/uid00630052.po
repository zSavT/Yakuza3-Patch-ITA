msgctxt "428"
msgid "Not right now."
msgstr ""

msgctxt "440"
msgid "Aww, really? I was really looking forward to hearing you sing, though..."
msgstr ""

msgctxt "452"
msgid "Kiryu-san... I'm starting to think you don't have a sense of rhythm."
msgstr ""

msgctxt "464"
msgid "Sorry."
msgstr ""

msgctxt "476"
msgid "Wow, you're actually pretty good! You sounded so cool!"
msgstr ""

msgctxt "488"
msgid "Saaay... Have you been practicing by yourself?"
msgstr ""

