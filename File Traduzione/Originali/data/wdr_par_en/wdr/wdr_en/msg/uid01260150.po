msgctxt "92"
msgid "Excuse me, sir."
msgstr ""

msgctxt "104"
msgid "You should really stay away from those lockers."
msgstr ""

msgctxt "116"
msgid "And why is that?"
msgstr ""

msgctxt "128"
msgid "Haruko! Shh... You shouldn't say stuff like that."
msgstr ""

msgctxt "140"
msgid "People say that Locker 44 over there is cursed."
msgstr ""

msgctxt "152"
msgid ""
"People hear groaning and clanging noises coming out of it\r\n"
"at night."
msgstr ""

msgctxt "164"
msgid ""
"I'm sorry. This girl loves to spread silly rumors. Don't\r\n"
"take her seriously, okay?"
msgstr ""

msgctxt "176"
msgid ""
"Let's go, you guys. Everybody knows all that stuff about\r\n"
"horrific sounds coming out of the locker is all a big lie."
msgstr ""

msgctxt "236"
msgid "(A cursed locker, huh... Spooky.)"
msgstr ""

