msgctxt "160"
msgid ""
"Use <Action:Button_L1@Golf> and <Action:Button_R1@Golf> to adjust the shot "
"direction."
msgstr ""

msgctxt "172"
msgid ""
"Change clubs by using "
"<Action:Button_RS_Up@Golf><Action:Button_RS_Down@Golf>."
msgstr ""

msgctxt "184"
msgid ""
"Press <Action:Button_Triangle@Golf> to change the shot range to\r\n"
"half the distance."
msgstr ""

msgctxt "196"
msgid ""
"Use the "
"<Action:Button_DPad_Up@Golf><Action:Button_DPad_Down@Golf><Action:Button_"
"DPad_Left@Golf><Action:Button_DPad_Right@Golf> to change the impact\r\n"
"point. Some points will put a spin on the ball."
msgstr ""

msgctxt "208"
msgid "Hold down <Action:Button_Cross@Golf> to build shot power."
msgstr ""

msgctxt "220"
msgid "Release <Action:Button_Cross@Golf> to set the shot power."
msgstr ""

msgctxt "232"
msgid ""
"After setting the power, press <Action:Button_Cross@Golf> just as the "
"cursor is\r\n"
"aligned with the ball to deliver the optimal impact."
msgstr ""