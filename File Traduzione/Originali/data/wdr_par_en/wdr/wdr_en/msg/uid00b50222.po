msgstr ""

msgctxt "1564"
msgid "You got 2,000 EXP."
msgstr ""

msgctxt "1576"
msgid "A studio goes for 100,000 yen."
msgstr ""

msgctxt "1588"
msgid "Roppongi would run you about 300,000 yen."
msgstr ""

msgctxt "1600"
msgid "About 60,000 yen if you're out in the suburbs."
msgstr ""

msgctxt "1612"
msgid "Parking fees are expensive in Tokyo."
msgstr ""

msgctxt "1624"
msgid "Ditch the car and take the train."
msgstr ""

msgctxt "1636"
msgid "Don't drink and drive!"
msgstr ""

msgctxt "1648"
msgid "If you want to go, then go."
msgstr ""

msgctxt "1660"
msgid "Your friend is right, Kaede."
msgstr ""

msgctxt "1672"
msgid "I'll help you move if you want."
msgstr ""

