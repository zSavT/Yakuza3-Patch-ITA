msgstr ""

msgctxt "128"
msgid "Man, but...!"
msgstr ""

msgctxt "140"
msgid ""
"(That reminds me. Rikiya was saying his viper tattoo wasn't complete yet. "
"Master Utabori might be able to finish it up for him.)"
msgstr ""

msgctxt "152"
msgid ""
