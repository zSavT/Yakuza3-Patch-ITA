msgctxt "80"
msgid "Huh? What do <Italic>you</Italic> want, ya old geezer?"
msgstr ""

msgctxt "92"
msgid ""
"Didn't anybody ever teach you any manners? You're the\r\n"
"Reaper Kurenai, aren't you?"
msgstr ""

msgctxt "104"
msgid ""
"Damn straight! Kurenai, the Silver Bullet! But how the hell\r\n"
"do you know about me?"
msgstr ""

msgctxt "116"
msgid ""
"I'm with the Honest Living Association. I want you to come\r\n"
"with me."
msgstr ""

msgctxt "128"
msgid "So you're from the HLA, are ya?"
msgstr ""

msgctxt "140"
msgid "Yeah, that's right."
msgstr ""

msgctxt "152"
msgid "Heh... Well, well! How convenient!"
msgstr ""

msgctxt "164"
msgid ""
"It just so happens I got something interesting to show ya.\r\n"
"Follow me."
msgstr ""

msgctxt "176"
msgid "You really think I'm gonna fall for this?"
msgstr ""

msgctxt "188"
msgid "C'mon, man. I swear it's really sweet. Just follow me."
msgstr ""

