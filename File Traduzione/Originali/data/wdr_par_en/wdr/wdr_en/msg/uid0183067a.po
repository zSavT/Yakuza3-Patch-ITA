msgctxt "64"
msgid "How to Play Eight-ball"
msgstr ""

msgctxt "76"
msgid "Eight-ball uses balls number 1 through 15."
msgstr ""

msgctxt "88"
msgid ""
"Pocket the object balls in order, starting with the lowest\r\n"
"number, by hitting them with the cue ball."
msgstr ""

msgctxt "100"
msgid ""
"Pocketing a ball awards the player with the same number\r\n"
"of points as the number on the ball."
msgstr ""

msgctxt "112"
msgid "The first player to exceed 61 points wins."
msgstr ""

msgctxt "124"
msgid "Fouls"
msgstr ""

msgctxt "136"
msgid ""
"A foul results if the cue ball falls into a pocket or does\r\n"
"not strike an object ball."
msgstr ""

msgctxt "148"
msgid ""
"The opposing player may then take a shot by placing the cue\r\n"
"ball anywhere on the table."
msgstr ""

msgctxt "160"
msgid "Now, let's give it a try."
msgstr ""