msgstr ""

msgctxt "2008"
msgid "Yeah, that's the one."
msgstr ""

msgctxt "2020"
msgid "Take me to Asia."
msgstr ""

msgctxt "2032"
msgid "Asia, the bikini bar?"
msgstr ""

msgctxt "2044"
msgid "Yeah, that's the one."
msgstr ""

msgctxt "2056"
msgid "Of course, sir. Just a moment, please."
msgstr ""

msgctxt "2068"
msgid "Hello? This is MEB calling. How are you this evening?"
msgstr ""

msgctxt "2080"
msgid "Um, yes, I have a guest here who'd like to come by now."
msgstr ""

msgctxt "2092"
msgid "So we're good? Great! Thank you!"
msgstr ""

msgctxt "2104"
msgid "Okay, sir, please follow me. I'll take you there right away."
msgstr ""

msgctxt "2176"
msgid "I'm sorry, sir, but you, um... You seem to be a little short on cash."
msgstr ""

