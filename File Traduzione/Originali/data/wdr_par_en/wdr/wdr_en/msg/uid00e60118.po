msgctxt "120"
msgid "Can't anybody do anything about him?"
msgstr ""

msgctxt "132"
msgid "What's wrong?"
msgstr ""

msgctxt "144"
msgid ""
"We've got a guy three sheets to the wind, and he keeps pushing other "
"customers to play some drinking game."
msgstr ""

msgctxt "156"
msgid ""
"The bartender's tried to stop him, but he won't listen. And anyone who "
"tries his game ends up too drunk to function."
msgstr ""

msgctxt "168"
msgid ""
"He's ruining the whole atmosphere of the place! No one wants to be anywhere "
"near him."
msgstr ""

msgctxt "180"
msgid "If we want him out, someone's going to have to outdrink him first."
msgstr ""

