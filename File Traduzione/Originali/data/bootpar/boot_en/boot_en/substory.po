msgstr ""

msgctxt "29664\tEXPLANATION"
msgid "I found the bag snatcher. Maybe I oughta teach him a lesson."
msgstr ""

msgctxt "29725\tEXPLANATION"
msgid ""
"That old lady took the snatcher away and gave me a little\n"
