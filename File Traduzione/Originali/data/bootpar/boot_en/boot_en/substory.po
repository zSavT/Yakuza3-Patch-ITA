msgctxt "37886\tEXPLANATION"
msgid ""
"Sawada came out of hiding in his office. Now it's time to get\n"
"back what's mine."
msgstr ""

msgctxt "37966\tEXPLANATION"
msgid "Sawada gave me back my money, and everything's settled."
