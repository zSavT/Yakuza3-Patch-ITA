msgctxt "132\t173"
msgid "Sir!"
msgstr ""

msgctxt "205\t240"
msgid "Where's Nakahara?"
msgstr ""

msgctxt "243\t297"
msgid "On the operating table."
msgstr ""

msgctxt "299\t346"
msgid "And?"
msgstr ""

msgctxt "355\t443"
msgid ""
"Is he okay?\\n"
"How's he doing!?"
msgstr ""

msgctxt "492\t539"
msgid "Dammit!"
msgstr ""

msgctxt "667\t785"
msgid ""
"Saki-chan.\\n"
"You must be terrified."
msgstr ""

msgctxt "836\t879"
msgid "Saki..."
msgstr ""

msgctxt "904\t975"
msgid "Are you okay?"
msgstr ""

msgctxt "1114\t1169"
msgid "We know who did it?"
msgstr ""

msgctxt "1172\t1216"
msgid "Nope."
msgstr ""

msgctxt "1219\t1328"
msgid ""
"He and the little lady\\n"
"were alone when it happened."
msgstr ""

msgctxt "1343\t1482"
msgid "Guy came in, shot him right in the stomach."
msgstr ""

msgctxt "1485\t1551"
msgid "Another family out for revenge?"
msgstr ""

msgctxt "1553\t1592"
msgid "No."
msgstr ""

msgctxt "1595\t1687"
msgid ""
"I think it's gotta do\\n"
"with the land deal."
msgstr ""

msgctxt "1693\t1805"
msgid ""
"The deed's up and gone missing\\n"
"from the office."
msgstr ""

msgctxt "1808\t1848"
msgid "What?"
msgstr ""

msgctxt "1851\t1933"
msgid "It's gotta be those Tamashiro assholes!"
msgstr ""

msgctxt "1935\t2043"
msgid ""
"They've been gunning for us\\n"
"nonstop since last year!"
msgstr ""

msgctxt "2046\t2159"
msgid "Nah, I don't think it was them."
msgstr ""

msgctxt "2240\t2294"
msgid "What's wrong, Saki?"
msgstr ""

msgctxt "2407\t2468"
msgid "Who's that?"
msgstr ""

msgctxt "2471\t2528"
msgid "What the!?"
msgstr ""

msgctxt "2530\t2590"
msgid "Is this the man who shot him?"
msgstr ""

msgctxt "2834\t2877"
msgid "But that's..."
msgstr ""

msgctxt "2879\t2910"
msgid "Aniki."
msgstr ""

msgctxt "2913\t3048"
msgid "You know him, don't you?"
msgstr ""

msgctxt "3051\t3100"
msgid "Yeah."
msgstr ""

msgctxt "3102\t3177"
msgid "He's the man who brought me up."
msgstr ""

msgctxt "3201\t3271"
msgid "Shintaro Kazama."
msgstr ""

msgctxt "3274\t3326"
msgid "My dead father."
msgstr ""