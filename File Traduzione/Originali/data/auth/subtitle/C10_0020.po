msgctxt "16\t131"
msgid ""
"\"After investigating the incident which\\n"
"took place yesterday at the National Diet Building...\""
msgstr ""

msgctxt "132\t342"
msgid ""
"\"Authorities are convinced it came about at the hands\\n"
"of a group opposing the Okinawa military expansion bill.\""
msgstr ""

msgctxt "339\t479"
msgid ""
"\"As we speak, patrols are on high alert\\n"
"in search of those behind the incident.\""
msgstr ""

msgctxt "480\t540"
msgid "Mind turning that off?"
msgstr ""

msgctxt "546\t606"
msgid "Of course."
msgstr ""