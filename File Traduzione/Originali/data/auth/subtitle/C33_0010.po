msgctxt "778\t955"
msgid ""
"It's a pleasure to meet you, too.\\n"
"Your manners are impeccable."
msgstr ""

msgctxt "993\t1088"
msgid "Hey, you! Are you Kiryu!?"
msgstr ""

msgctxt "1119\t1222"
msgid ""
"What kind of parenting\\n"
"are you doing over here!?"
msgstr ""

msgctxt "1223\t1360"
msgid ""
"Look what your kid did to this poor boy!\\n"
"What were you thinking!?"
msgstr ""

msgctxt "1371\t1483"
msgid ""
"Oh, Hashimoto-san.\\n"
"Good to see you."
msgstr ""

msgctxt "1645\t1712"
msgid "Akasaka-sensei!?"
