msgctxt "1611\tEXPLANATION"
msgid ""
"A construction company run by the Tojo Clan-affiliated Majima Family. "
"President: Goro Majima."
msgstr ""

msgctxt "1707\tEXPLANATION"
msgid ""
"A yakuza syndicate in control of Kamurocho and the Kanto region. Run by "
"Sixth Chairman Daigo Dojima."
msgstr ""

msgctxt "1810\tEXPLANATION"
msgid ""
"One of the central families of the Tojo Clan. Formerly estranged but has "
"since returned to the clan. Patriarch: Goro Majima."
msgstr ""

msgctxt "1937\tEXPLANATION"
msgid ""
"One of the central families of the Tojo Clan. Formerly estranged but has "
"since returned to the clan. Patriarch: Goro Majima."
msgstr ""

msgctxt "2064\tEXPLANATION"
msgid "One of the central families of the Tojo Clan. Patriarch: Goh Hamazaki."
msgstr "Una delle famiglie centrali del Clan Tojo. Patriarca: Goh Hamazaki."

msgctxt "2137\tEXPLANATION"
msgid ""
"One of the central families of the Tojo Clan. A small but powerful "
"organization based out of Yokohama. Patriarch: Goh Hamazaki."
msgstr ""

msgctxt "2267\tEXPLANATION"
msgid ""
"One of the central families of the Tojo Clan. Patriarch Osamu Kashiwagi now "
"runs it in place of the late founder Shintaro Kazama."
msgstr ""

msgctxt "2399\tEXPLANATION"
msgid ""
"One of the central families of the Tojo Clan. Chairman: Yoshitaka Mine."
msgstr ""

msgctxt "2473\tEXPLANATION"
msgid ""
"One of the central families of the Tojo Clan. After growing rapidly due to "
"vast funds, the Hakuho Clan now currently handles financial support for the "
"entire Tojo Clan. Chairman: Yoshitaka Mine."
msgstr ""

msgctxt "2670\tEXPLANATION"
msgid ""
"One of the central families of the Tojo Clan. Patriarch Tsuyoshi Kanda now "
"runs it in place of its founder Akira Nishikiyama and second head Koji "
"Shindo."
msgstr ""

msgctxt "2826\tEXPLANATION"
msgid ""
"Tokyo's central police organization. Protects VIPs and national property."
msgstr ""

msgctxt "2902\tEXPLANATION"
msgid "Kiryu's allies through various hardships."
msgstr "Gli alleati di Kiryu attraverso varie difficoltà."

msgctxt "2946\tEXPLANATION"
msgid ""
"An orphanage in Okinawa. After its former director passed away, Kazuma Kiryu"
" takes over to assist with management. He and the children now live together"
" at the orphanage."
msgstr ""

msgctxt "3119\tEXPLANATION"
msgid ""
"A yakuza organization in control of the southern area of Downtown Ryukyu. "
"Patriarch: Shigeru Nakahara."
msgstr ""

msgctxt "3224\tEXPLANATION"
msgid ""
"A yakuza organization in control of the northern area of Downtown Ryukyu. "
"Patriarch: Tetsuo Tamashiro."
msgstr ""

msgctxt "3329\tEXPLANATION"
msgid ""
"A yakuza organization in control of the northern area of Downtown Ryukyu. "
"Affiliated with the Tojo Clan. Patriarch: Tetsuo Tamashiro."
msgstr ""

msgctxt "3465\tEXPLANATION"
msgid ""
"The controlling political party. Minister of Defense Tamiya's military "
"expansion bill and Minister of Land, Infrastructure, and Transportation "
"Suzuki's resort deal are garnering national attention."
msgstr ""

msgctxt "3665\tEXPLANATION"
msgid ""
"A mafia organization based in mainland China. The Japanese branch is headed "
"by Lau Ka Long."
msgstr ""

msgctxt "3759\tEXPLANATION"
msgid "An unknown person encountered by Kiryu."
msgstr "Una persona sconosciuta incontrata da Kiryu."

msgctxt "3801\tEXPLANATION"
msgid "Unknown persons encountered by Kiryu."
msgstr "Persone sconosciute incontrate da Kiryu."

msgctxt "3841\tEXPLANATION"
msgid ""
"The American Central Intelligence Agency. The CIA is conducting operations "
"in Japan to destroy the international arms smuggling syndicate known as "
"Black Monday."
msgstr ""
