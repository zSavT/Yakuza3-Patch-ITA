msgctxt "112"
msgid ""
"Use the <Action:Button_DPad_Left@Bowling><Action:Button_DPad_Right@Bowling> "
"buttons to choose where to stand, then confirm with "
"<Action:Button_Cross@Bowling>."
msgstr ""
"Premi i tasti "
"<Action:Button_DPad_Left@Bowling><Action:Button_DPad_Right@Bowling> per "
"scegliere dove posizionarti, poi conferma con il tasto "
"<Action:Button_Cross@Bowling>."

msgctxt "124"
msgid "Press <Action:Button_Cross@Bowling> to determine the direction."
msgstr ""
"Premi il pulsante <Action:Button_Cross@Bowling> per determinare la "
"direzione."

msgctxt "136"
msgid "Press <Action:Button_Cross@Bowling> to adjust throwing power."
msgstr ""
"Premi il tasto <Action:Button_Cross@Bowling> per regolare la potenza di "
"lancio."

msgctxt "148"
msgid ""
"Press <Action:Button_DPad_Left@Bowling><Action:Button_DPad_Right@Bowling> "
"before releasing the ball to adjust the spin."
msgstr ""

