msgctxt "1012"
msgid "Eh, might as well. C'mon, let's go."
msgstr ""

msgctxt "1048"
msgid "Why don't we go shopping at Le Marche?"
msgstr "Che ne dici se andiamo a fare shopping a Le Marche?"

msgctxt "1060"
msgid "Ooh, we're going there!? Are you gonna pick something out for me?"
msgstr ""

msgctxt "1072"
msgid "Heheheh... I wonder what you'll get me! <Color:7>⑮<Color:Default>"
