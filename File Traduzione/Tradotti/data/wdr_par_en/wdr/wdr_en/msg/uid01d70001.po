msgctxt "240"
msgid "I'll draw a card."
msgstr "Tirerò una carta."

msgctxt "252"
msgid "I'll stay with this hand."
msgstr "Sto con questa mano."

msgctxt "264"
msgid "You can double your bet, but you must draw one more card."
msgstr "Puoi raddoppiare la tua puntata, ma devi pescare una carta in più."

msgctxt "276"
msgid ""
"Split your hand in two. The second hand will mirror your\r\n"
"current bet."
msgstr ""
"Dividi la tua mano in due. La seconda mano eguaglierà la tua puntata "
"attuale."

msgctxt "288"
msgid "Folding at this point will return half of your current bet."
msgstr "Ritirarsi a questo punto ti restituirà metà della puntata attuale."

msgctxt "300"
msgid ""
"Set half the bet amount as insurance against the dealer\r\n"
"getting a blackjack."
msgstr ""
"Punta la metà della puntata come assicurazione contro un blackjack del "
"banco."

msgctxt "312"
msgid "Refer to the bet limit to see how many chips you can bet."
msgstr "Consulta il limite di puntata per vedere quante fiches puoi puntare."

msgctxt "324"
msgid "Play by betting the same amount as in the last game."
msgstr "Gioca puntando la stessa cifra della partita precedente."

msgctxt "336"
msgid ""
"Standard Blackjack\r\n"
"Bonus: 2,000 chips"
msgstr ""

msgctxt "348"
msgid ""
"Blackjack using a deck with no 2, 3, or 4 cards.\r\n"
"Bonus: 2,500 chips"
msgstr ""

msgctxt "360"
msgid ""
"Blackjack using a deck with no 7, 8, or 9 cards.\r\n"
"Bonus: 2,000 chips"
msgstr ""

msgctxt "372"
msgid ""
"Blackjack using a deck with no J, Q, or K cards.\r\n"
"Bonus: 4,000 chips"
msgstr ""
