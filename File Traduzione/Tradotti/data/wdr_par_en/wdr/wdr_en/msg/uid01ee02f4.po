msgctxt "272"
msgid "(Boxcelios... An arcade shooter...)"
msgstr ""

msgctxt "284"
msgid ""
"Boxcelios puts you in the seat of an invincible fighter and challenges you "
"to destroy as many enemies as possible before time runs out. Move your ship "
"with the "
"<Action:Button_LS_Up@Shooting><Action:Button_LS_"
"Down@Shooting><Action:Button_LS_Left@Shooting><Action:Button_LS_"
"Right@Shooting>, and fire your laser cannons with "
"<Action:Button_Cross@Shooting>."
msgstr ""

msgctxt "296"
msgid ""
"Shoot and destroy either the glowing core or the majority of enemy ships to "
"take them down."
msgstr ""

msgctxt "308"
msgid ""
"Time stands still for two seconds after an enemy appears. Use this time to "
"aim for the enemy's core for maximum efficiency."
msgstr ""

