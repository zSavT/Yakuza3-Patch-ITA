msgid "Looking at different areas will provoke different reactions."
msgstr ""

msgctxt "572"
msgid "(Her eyes...?)"
msgstr ""

msgctxt "584"
msgid "(Her lips...?)"
msgstr ""

msgctxt "596"
msgid "(Her hands are nice...)"
msgstr "(Ha delle belle mani...)"

msgctxt "608"
msgid "(It's covered up by her dress, but I'm sure she has great legs...)"
msgstr ""

msgctxt "620"
msgid "(Her beautiful hair...)"
msgstr "(I suoi bellissimi capelli?)"

