msgstr ""

msgctxt "520"
msgid "Hey. Leave that man alone."
msgstr ""

msgctxt "532"
msgid ""
"Who the hell are you!? This ain't none of your goddamn\r\n"
"business!"
msgstr ""

msgctxt "544"
msgid ""
"As soon as I see somebody hitting an old man, then it\r\n"
"becomes my business. So back off."
msgstr ""

msgctxt "556"
msgid ""
"How 'bout I back my fist up in that stupid-lookin' face of\r\n"
"yours instead!?"
msgstr ""

