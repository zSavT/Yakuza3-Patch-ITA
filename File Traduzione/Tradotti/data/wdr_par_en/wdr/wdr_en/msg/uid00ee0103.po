msgctxt "236"
msgid "Hello, sir. Are you looking for anything in particular?"
msgstr "Salve, signore. Cerca qualcosa in particolare?"

msgctxt "296"
msgid "Huh? You're not going to get anything? Really?"
msgstr "Eh? Non prenderai niente? Uh... Davvero?"

msgctxt "308"
msgid "Sorry..."
msgstr "Scusa..."

msgctxt "332"
msgid "I'll take this."
msgstr "Prendo questo."

msgctxt "344"
msgid "Thank you very much! Let me walk you to the door."
msgstr "La ringrazio molto! Mi permetta di accompagnarla alla porta."

