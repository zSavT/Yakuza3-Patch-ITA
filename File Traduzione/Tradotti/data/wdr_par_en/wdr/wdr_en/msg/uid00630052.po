msgstr ""

msgctxt "596"
msgid "Oh, I know that one! It's one of my favorites! ♪"
msgstr "Oh, questa la conosco! È una delle mie preferite!"

msgctxt "608"
msgid "Nah, not right now."
msgstr "Nah, non adesso."

msgctxt "620"
msgid "Aww, really? I wanted to hear you sing..."
msgstr ""

msgctxt "632"
msgid ""
"Whoa! I never thought you'd be that good! You looked\r\n"
"so cool, too! <Color:7>⑮<Color:Default>"
msgstr ""

msgctxt "644"
msgid "Oh, yeah? Thanks."
msgstr "Ah sì? Grazie."

