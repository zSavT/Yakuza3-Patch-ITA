msgctxt "108"
msgid "Welcome. Can I take your order?"
msgstr ""

msgctxt "132"
msgid ""
"Uncle Kaz! Can I pleeease get a <Color:8>Strawberry Parfait<Color:Default>?"
msgstr ""
"Zio Kaz! Mi prendi per favooore un <Color:8>Parfait alla "
"fragola<Color:Default>?"

msgctxt "144"
msgid ""
"(Haruka wants me to get her a <Color:8>Strawberry Parfait<Color:Default>...)"
msgstr ""
"(Haruka vuole che io le prenda un <Color:8>Parfait alla "
"fragola<Color:Default>...)"

msgctxt "168"
msgid "Aww, I wanted a <Color:8>Strawberry Parfait<Color:Default>..."
msgstr "Uffa... volevo un <Color:8>Parfait alla fragola<Color:Default>..."

msgctxt "180"
msgid "Thank you very much."
msgstr "Grazie mille."

msgctxt "204"
msgid "Thanks, Uncle Kaz! I was really craving this!"
msgstr "Grazie, zio Kaz! Ne avevo proprio una gran voglia!"

msgctxt "264"
msgid "Mmm, so sweet and yummy! ⑮ Thanks for treating me!"
msgstr "Mmm, così dolce e buonissimo! ♥ Grazie per avermi offerto!"

msgctxt "276"
msgid "(Haruka seems happy...)"
msgstr ""

msgctxt "300"
msgid ""
"Uncle Kaz, I'm really craving a <Color:8>Cake Set<Color:Default>... "
"Pleeease?"
msgstr ""
"Zio Kaz, ho proprio una gran voglia di una <Color:8>Selezione di "
"torte<Color:Default>... Ti pregooo?"

msgctxt "312"
msgid "(Haruka wants me to get her a <Color:8>Cake Set<Color:Default>...)"
msgstr ""
"(Haruka vuole che le prenda una <Color:8>Selezione di "
"torte<Color:Default>...)"

msgctxt "336"
msgid "But I wanted a <Color:8>Cake Set<Color:Default>..."
msgstr "Ahhh, volevo la <Color:8>Selezione di torte<Color:Default>..."

msgctxt "348"
msgid "Thank you very much."
msgstr "Grazie mille."

msgctxt "372"
msgid "Thanks, Uncle Kaz! I can't wait to dig in!"
msgstr "Grazie, zio Kaz! Non vedo l'ora di papparmelo!"

msgctxt "432"
msgid "Mmm, so sweet and yummy! ⑮ Thanks for treating me!"
msgstr "Mmm, così dolce e buonissimo! ♥ Grazie per avermi offerto!"

msgctxt "444"
msgid "(Haruka seems happy...)"
msgstr ""

msgctxt "516"
msgid "Thanks a ton, Uncle Kaz! I have a present for you!"
msgstr "Grazie mille, zio Kaz! Ho un regalo per te!"

msgctxt "528"
msgid "You got <Color:8>Haruka's Necklace<Color:Default>."
msgstr "Hai ottenuto <Color:8>Collana di Haruka<Color:Default>."

msgctxt "576"
msgid ""
"Thanks a ton, Uncle Kaz! I wanna come with you to play\r\n"
"cho-han with you next time, okay?"
msgstr ""
"Grazie un sacco, zio Kaz! La prossima volta voglio venire a fare una partita"
" a cho-han con te, ok?"

msgctxt "588"
msgid ""
"Haruka will now occasionally predict the outcome of a round\r\n"
"when you are playing cho-han."
msgstr ""
"D'ora in poi, Haruka a volte prevederà l'esito di una mano quando giochi a "
"cho-han."

msgctxt "624"
msgid "Thanks a ton, Uncle Kaz! I have a present for you!"
msgstr "Grazie mille, zio Kaz! Ho un regalo per te!"

msgctxt "636"
msgid "You got <Color:8>Haruka's Bento<Color:Default>."
msgstr "Hai ottenuto <Color:8>L'Amuleto di Haruka<Color:Default>."

msgctxt "684"
msgid "Thanks a ton, Uncle Kaz! I have a present for you!"
msgstr "Grazie mille, zio Kaz! Ho un regalo per te!"

msgctxt "696"
msgid "You got <Color:8>Haruka's First-Aid Kit<Color:Default>."
msgstr ""
"Hai ottenuto <Color:8>Kit di pronto soccorso di Haruka<Color:Default>."

msgctxt "744"
msgid "Thanks a ton, Uncle Kaz! I have a present for you!"
msgstr "Grazie mille, zio Kaz! Ho un regalo per te!"

msgctxt "756"
msgid "You got a <Color:8>Red Jewel<Color:Default>."
msgstr "Hai ottenuto un <Color:8>Gioiello rosso<Color:Default>."

msgctxt "804"
msgid "Thanks a ton, Uncle Kaz! I have a present for you!"
msgstr "Grazie mille, zio Kaz! Ho un regalo per te!"

msgctxt "816"
msgid "You got <Color:8>Haruka's Amulet<Color:Default>."
msgstr "Hai ottenuto <Color:8>L'Amuleto di Haruka<Color:Default>."

msgctxt "864"
msgid "Thanks a ton, Uncle Kaz! I have a present for you!"
msgstr "Grazie mille, zio Kaz! Ho un regalo per te!"

msgctxt "876"
msgid "You got <Color:8>Haruka's Chocolate<Color:Default>."
msgstr "Hai ottenuto <Color:8>Il cioccolato di Haruka<Color:Default>."

