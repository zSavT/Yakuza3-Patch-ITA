msgctxt "152"
msgid ""
"Welcome. Here, you can play Texas hold 'em poker. Would\r\n"
"you like to play?"
msgstr ""
"Benvenuto. Qui, puoi giocare a Texas hold 'em poker. Ti va di giocare?"

msgctxt "164"
msgid "Yeah, I have a feeling today's my lucky day."
msgstr "Già, sento che oggi è il mio giorno fortunato."

msgctxt "176"
msgid "An excellent choice. What stakes would you like to play for?"
msgstr "Ottima scelta. A che puntate vuole giocare?"

msgctxt "188"
msgid "I'll go with the low stakes."
msgstr "Vado con le puntate basse."

msgctxt "212"
msgid "Very well, please take your seat."
msgstr ""

msgctxt "236"
msgid ""
"You'll need a minimum of 100 chips to play low-stakes\r\n"
"poker, sir."
msgstr ""
"Ti serviranno almeno 100 fiches per giocare a poker a puntate basse, "
"signore."

msgctxt "248"
msgid "I'll go with the high stakes."
msgstr "Vado con la posta alta."

msgctxt "272"
msgid "Very well, please take your seat."
msgstr ""

msgctxt "296"
msgid ""
"You'll need a minimum of 1,000 chips to play high-stakes\r\n"
"poker, sir."
msgstr ""
"Ti serviranno un minimo di 1.000 chips per giocare a poker ad alte puntate, "
"signore."

msgctxt "308"
msgid "Not right now."
msgstr "Non adesso."

msgctxt "320"
msgid "I see. We hope you'll play next time."
msgstr "Capisco. Speriamo che giocherai la prossima volta."

msgctxt "332"
msgid "Yes"
msgstr "            Sì            "

msgctxt "344"
msgid "No"
msgstr ""

msgctxt "356"
msgid "Low Stakes (5 chips/10 chips)"
msgstr "Puntate Basse (5 fiches/10 fiches)"

msgctxt "368"
msgid "High Stakes (50 chips/100 chips)"
msgstr "Poste Alte (50 fiches/100 fiches)"

