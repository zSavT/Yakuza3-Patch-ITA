msgctxt "240"
msgid "Let's start by choosing the banker."
msgstr ""

msgctxt "252"
msgid "All right, I'm the banker."
msgstr "Ok, il banco lo tengo io."

msgctxt "264"
msgid "How much are you gonna wager?"
msgstr "Quanto vuoi puntare?"

msgctxt "276"
msgid "Ready to get started?"
msgstr "Pronto per iniziare?"

msgctxt "288"
msgid "Looks like I'm up."
msgstr "Mi sa che sono in vantaggio."

msgctxt "300"
msgid "(This line signifies failure.)"
msgstr "(Questa riga indica fallimento.)"

msgctxt "312"
msgid "Let's settle our bets, eh?"
msgstr ""

msgctxt "324"
msgid "You're the banker, son."
msgstr "Sei il banchiere, figliolo."

msgctxt "336"
msgid "Time to change bankers."
msgstr "Tempo di cambiare banchieri."

msgctxt "348"
msgid "Wanna play one more?"
msgstr "Ti va un'altra?"

msgctxt "360"
msgid ""
"Hmph... Guess that's it, huh?\r\n"
"Can't teach an old dog new tricks..."
msgstr ""

msgctxt "372"
msgid ""
"Seems your luck ran out, boy.\r\n"
"Come back once you've sharpened up."
msgstr ""

msgctxt "1464"
msgid "Psychic Kihachi"
msgstr ""
