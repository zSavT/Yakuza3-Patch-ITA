msgctxt "64"
msgid "You're a tough one, Kiryu-san! You got me beat."
msgstr ""

msgctxt "76"
msgid ""
"I thought I could take on a pro, but it looks like I've still got a ways to "
"go."
msgstr ""

msgctxt "88"
msgid ""
"Tamura-kun, have you prepared what I told\r\n"
"you for Kiryu-san?"
msgstr ""

msgctxt "112"
msgid "Yes, of course. Kiryu-san, please accept this token of our gratitude."
msgstr ""

msgctxt "124"
msgid "You got <Color:8>100,000 yen<Color:Default>."
msgstr "Hai ottenuto <Color:8>100.000 yen<Color:Default>."

msgctxt "184"
msgid ""
"(Really, thank you. The president will be much easier to deal with from now "
"on, thanks to you.)"
msgstr ""

msgctxt "196"
msgid "(This is from me. It's not much, but please accept it.)"
msgstr ""

msgctxt "208"
msgid "You got a <Color:8>Staminan Spark<Color:Default>."
msgstr "Hai ottenuto <Color:8>uno Staminan Spark<Color:Default>."

msgctxt "232"
msgid "I hope we see you again. Next time I won't lose!"
msgstr ""

msgctxt "256"
msgid "You got 3,000 EXP."
msgstr ""

