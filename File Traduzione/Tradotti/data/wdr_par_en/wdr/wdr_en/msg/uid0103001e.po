msgctxt "240"
msgid "We're picking banker first, right?"
msgstr ""

msgctxt "252"
msgid "Guess I'm the banker."
msgstr "Mi sa che sono io il banchiere."

msgctxt "264"
msgid "How much do you wanna bet?"
msgstr "Quanto vuoi puntare?"

msgctxt "276"
msgid "Let's start the match."
msgstr "Si dà il via alla partita."

msgctxt "288"
msgid "My turn."
msgstr "Tocca a me."

msgctxt "300"
msgid "(This line signifies failure.)"
msgstr "(Questa riga indica fallimento.)"

msgctxt "312"
msgid "Shall we settle up?"
msgstr "Saldiamo?"

msgctxt "324"
msgid "You're banker."
msgstr "Sei il banchiere."

msgctxt "336"
msgid "Let's change bankers, okay?"
msgstr "Cambiamo banchiere, va bene?"

msgctxt "348"
msgid "Wanna try again?"
msgstr "Vuoi riprovare?"

msgctxt "360"
msgid ""
"I'm cleaned out...\r\n"
"I'd better call it quits."
msgstr "Sono a secco... Meglio che molli."

msgctxt "372"
msgid ""
"Well, that's it for you.\r\n"
"Next time, huh?"
msgstr ""

msgctxt "1352"
msgid "Satoru the Mouse"
msgstr ""
