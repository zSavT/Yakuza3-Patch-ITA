msgctxt "240"
msgid "Let's pick the banker."
msgstr "Scegliamo il banco."

msgctxt "252"
msgid ""
"So I'm the banker.\r\n"
"Let's place our bets."
msgstr "Allora, il banco sono io. Piazzate le puntate."

msgctxt "264"
msgid "How much you wanna wager?"
msgstr "Quanto vuoi puntare?"

msgctxt "276"
msgid "Let's do this!"
msgstr "Facciamolo!"

msgctxt "288"
msgid "My turn!"
msgstr "Tocca a me!"

msgctxt "300"
msgid "One more time."
msgstr "Ancora una volta."

msgctxt "312"
msgid "Let's settle our bets."
msgstr "Regoliamo i conti."

msgctxt "324"
msgid "You're the banker."
msgstr "Sei il banchiere."

msgctxt "336"
msgid "Banker change."
msgstr ""

msgctxt "348"
msgid "Wanna play again?"
msgstr "Ti va di giocare ancora?"

msgctxt "360"
msgid "I'm flat broke!"
msgstr ""

msgctxt "372"
msgid "Better luck next time."
msgstr "Sarà per la prossima volta."

msgctxt "1216"
msgid "Nagaharu"
msgstr ""
