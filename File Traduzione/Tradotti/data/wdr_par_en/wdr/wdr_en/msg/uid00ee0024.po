msgctxt "124"
msgid "Welcome. Have you decided what you would like?"
msgstr "Benvenuto. Ha deciso cosa desidera?"

msgctxt "148"
msgid "Uncle Kaz! I want some <Color:8>Smile Fries<Color:Default>!"
msgstr "Zio Kaz! Voglio delle <Color:8>Patatine Smile<Color:Default>!"

msgctxt "160"
msgid ""
"(Haruka wants me to get her some <Color:8>Smile Fries<Color:Default>...)"
msgstr ""
"(Haruka vuole che le prenda delle <Color:8>Patatine "
"Sorriso<Color:Default>...)"

msgctxt "184"
msgid "But I wanted some <Color:8>Smile Fries<Color:Default>..."
msgstr "Voglio delle <Color:8>Patatine Sorriso<Color:Default>!"

msgctxt "196"
msgid "Thank you very much."
msgstr "Grazie mille."

msgctxt "220"
msgid "Thanks, Uncle Kaz!"
msgstr "Grazie, zio Kaz!"

msgctxt "280"
msgid "That was delicious! I hope we come back here some time!"
msgstr "È stato buonissimo! Spero che ci torneremo qui un'altra volta!"

msgctxt "292"
msgid "(Haruka seems happy...)"
msgstr ""

msgctxt "316"
msgid ""
"Uncle Kaz! I really want a <Color:8>Smile Cheeseburger Set<Color:Default>..."
" Will you get one for me?"
msgstr ""
"Zio Kaz! Voglio proprio un <Color:8>Set Cheeseburger Smile<Color:Default>..."
" Me ne prendi uno?"

msgctxt "328"
msgid ""
"(Haruka wants me to get her a <Color:8>Smile Cheeseburger "
"Set<Color:Default>...)"
msgstr ""
"(Haruka vuole che le prenda un <Color:8>Smile Cheeseburger "
"Set<Color:Default>...)"

msgctxt "352"
msgid "Aww, I wanted a <Color:8>Smile Cheeseburger Set<Color:Default>..."
msgstr ""
"Uffa, io volevo mangiare un <Color:8>Set Cheeseburger "
"Sorriso<Color:Default>..."

msgctxt "364"
msgid "Thank you very much."
msgstr "Grazie mille."

msgctxt "388"
msgid "Thanks, Uncle Kaz!"
msgstr "Grazie, zio Kaz!"

msgctxt "448"
msgid "That was so yummy! Thanks for treating me, Uncle Kaz!"
msgstr "Che bontà! Grazie per avermelo offerto, zio Kaz!"

msgctxt "460"
msgid "(Haruka seems happy...)"
msgstr ""

msgctxt "532"
msgid "Thanks a ton, Uncle Kaz! I have a present for you!"
msgstr "Grazie mille, zio Kaz! Ho un regalo per te!"

msgctxt "544"
msgid "You got <Color:8>Haruka's Necklace<Color:Default>."
msgstr "Hai ottenuto <Color:8>Collana di Haruka<Color:Default>."

msgctxt "592"
msgid ""
"Thanks a ton, Uncle Kaz! I wanna come with you to play\r\n"
"cho-han with you next time, okay?"
msgstr ""
"Grazie un sacco, zio Kaz! La prossima volta voglio venire a fare una partita"
" a cho-han con te, ok?"

msgctxt "604"
msgid ""
"Haruka will now occasionally predict the outcome of a round\r\n"
"when you are playing cho-han."
msgstr ""
"D'ora in poi, Haruka a volte prevederà l'esito di una mano quando giochi a "
"cho-han."

msgctxt "640"
msgid "Thanks a ton, Uncle Kaz! I have a present for you!"
msgstr "Grazie mille, zio Kaz! Ho un regalo per te!"

msgctxt "652"
