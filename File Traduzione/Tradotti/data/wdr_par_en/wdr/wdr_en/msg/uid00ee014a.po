msgctxt "268"
msgid "It looks like you don't have enough chips to play roulette, sir."
msgstr ""
"Pare che non abbia abbastanza fiches per giocare alla roulette, signore."

msgctxt "280"
msgid "If you'd like to purchase chips, you can do so at the front desk."
msgstr "Se desideri acquistare fiches, puoi farlo alla cassa."

msgctxt "292"
msgid "Welcome. Would you like to play roulette?"
msgstr "Benvenuto. Vuole giocare a roulette?"

msgctxt "316"
msgid "Uncle Kaz! Get 1,000 points in roulette!"
msgstr "Zio Kaz! Fai 1.000 punti alla roulette!"

msgctxt "328"
msgid "(1,000 points in roulette... Should I give it a try?)"
msgstr "(1.000 punti alla roulette... Mi butto?)"

msgctxt "340"
msgid "All right, I'll play."
msgstr "Va bene, ci sto."

msgctxt "352"
msgid "An excellent choice."
msgstr ""

msgctxt "364"
msgid "Good luck, Uncle Kaz!"
msgstr "Buona fortuna, zio Kaz!"

msgctxt "388"
msgid "Not right now."
msgstr "Non adesso."

msgctxt "400"
msgid "Very well. We hope you'll play with us next time."
msgstr "Molto bene. Speriamo che giocherai con noi la prossima volta."

msgctxt "412"
msgid "But I wanted you to play roulette..."
msgstr "Ma volevo che giocassi alla roulette..."

