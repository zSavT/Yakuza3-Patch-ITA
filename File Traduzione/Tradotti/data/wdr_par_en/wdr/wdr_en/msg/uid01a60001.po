msgctxt "112"
msgid "Welcome to the roulette table."
msgstr "Benvenuto al tavolo della roulette."

msgctxt "124"
msgid "Let's begin."
msgstr "Iniziamo."

msgctxt "136"
msgid ""
"Welcome to the roulette table. Would you like to play\r\n"
"against the house, one-on-one?"
msgstr ""

msgctxt "148"
msgid "Let's begin."
msgstr "Iniziamo."

msgctxt "160"
msgid "We look forward to seeing you again."
msgstr "Speriamo di rivederla."

msgctxt "172"
msgid ""
"You seem to be short on chips. Please come visit\r\n"
"us again soon."
msgstr "Sembra che tu sia a corto di fiches. Ti aspettiamo di nuovo presto."

msgctxt "764"
msgid "Dealer"
msgstr "Croupier"
