msgid "Are you going out with Uncle Rikiya? Okay, see you later!"
msgstr ""

msgctxt "192"
msgid "Going somewhere, Uncle Kaz?"
msgstr "Vai da qualche parte, zio Kaz?"

msgctxt "204"
msgid "Looks like it, yeah."
msgstr "Pare di sì, eh."

msgctxt "216"
msgid "I wanna go, too! Can I come with you?"
msgstr "Voglio venire anch'io! Posso venire con voi?"

msgctxt "228"
msgid "Sorry, Haruka. Not this time."
msgstr "Scusa, Haruka. Non stavolta."

msgctxt "240"
msgid "Oh... Then promise you'll take me next time!"
msgstr "Oh... Allora promettimi che mi ci porti la prossima volta!"

msgctxt "252"
msgid "All right, sure."
msgstr "Ok, certo."

msgctxt "264"
msgid "Hurray! So where're we going?"
msgstr "Evviva! Allora, dove andiamo?"

msgctxt "312"
msgid "Sorry, not this time."
msgstr "Scusa, non questa volta."

