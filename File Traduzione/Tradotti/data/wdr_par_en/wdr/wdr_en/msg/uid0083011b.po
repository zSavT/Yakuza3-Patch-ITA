msgctxt "332"
msgid ""
"Ya need at least 100 chips to play oicho-kabu. You can buy 'em at the front."
msgstr ""
"Ti servono almeno 100 fiches per giocare a oicho-kabu. Le puoi prendere alla"
" cassa."

msgctxt "344"
msgid "Hey, buddy! Wanna play oicho-kabu?"
msgstr "Ehi, compare! Vuoi giocare a oicho-kabu?"

msgctxt "368"
msgid "Uncle Kaz! Get 800 points in oicho-kabu!"
msgstr "Zio Kaz! Fai 600 punti a oicho-kabu!"

msgctxt "380"
msgid "(800 points in oicho-kabu... Should I give it a try?)"
msgstr "(600 punti a oicho-kabu... Ci provo?)"

msgctxt "392"
msgid "Sure. I'll play."
msgstr "Certo, ci sto."

msgctxt "404"
msgid "You got it! Let's do this!"
msgstr "Ci siamo! Si parte!"

msgctxt "416"
msgid "Good luck, Uncle Kaz!"
msgstr "Buona fortuna, zio Kaz!"

msgctxt "440"
msgid "Not right now."
msgstr "Non adesso."

msgctxt "452"
msgid "I gotcha. Maybe next time."
msgstr "Capito. Magari la prossima volta."

msgctxt "464"
msgid "Aww... I wanted you to play oicho-kabu..."
msgstr "Uffa... Volevo che giocassi a oicho-kabu..."

