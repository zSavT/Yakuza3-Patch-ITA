msgid "Mod Weapons"
msgstr "Modda Armi"

msgctxt "636"
msgid "Mod Gear or Accessories"
msgstr "Modifica Equipaggiamento o Accessori"

msgctxt "648"
msgid "Repair Weapons"
msgstr "Ripara Armi"

msgctxt "660"
msgid "Reload Ammo"
msgstr "Ricarica Munizioni"

msgctxt "672"
msgid "View Designs"
msgstr "Visualizza Progetti"

msgctxt "684"
msgid "Buy Equipment/Designs"
msgstr "Compra Equipaggiamento/Progetti"

msgctxt "696"
msgid "Never Mind"
msgstr "Lascia perdere"

