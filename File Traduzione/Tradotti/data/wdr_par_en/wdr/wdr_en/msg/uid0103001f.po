msgctxt "240"
msgid "Let's pick the banker."
msgstr "Scegliamo il banco."

msgctxt "252"
msgid "I'm the banker."
msgstr "Faccio io il banco."

msgctxt "264"
msgid "(How much should I wager?)"
msgstr "(Quanto dovrei puntare?)"

msgctxt "276"
msgid "Here goes."
msgstr "Si parte."

msgctxt "288"
msgid "It's my turn."
msgstr "È il mio turno."

msgctxt "300"
msgid "I'll roll again."
msgstr "Tiro di nuovo."

msgctxt "312"
msgid "Let's settle up."
msgstr "Saldiamo i conti."

msgctxt "324"
msgid "(You're the banker.)"
msgstr "(Sei il banchiere.)"

msgctxt "336"
msgid "Time to change bankers."
msgstr "Tempo di cambiare banchieri."

msgctxt "348"
msgid "(Play again?)"
msgstr "(Facciamo un altro giro?)"

msgctxt "360"
msgid "(I'm broke.)"
msgstr "(Sono al verde.)"

msgctxt "372"
msgid "(Maybe next time.)"
msgstr "Magari la prossima volta."

msgctxt "1092"
msgid "Kiryu"
msgstr ""
