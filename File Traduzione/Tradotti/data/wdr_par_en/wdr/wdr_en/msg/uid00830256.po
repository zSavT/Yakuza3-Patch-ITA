msgctxt "140"
msgid ""
"We'll need you to buy wooden tags if you want to play here.\r\n"
"How many would you like? One tag is 100 yen."
msgstr ""
"Ti tocca prendere i targhette di legno se vuoi giocare qui. Quanti ne vuoi? "
"Un tag sono 100 yen."

msgctxt "152"
msgid "I'll take 50 tags."
msgstr "Prendo 50 gettoni."

msgctxt "176"
msgid "Okay, here you go. Have fun!"
msgstr "Perfetto, ecco a te. Divertiti!"

msgctxt "200"
msgid "I'll take 100 tags."
msgstr "Prendo 100 gettoni."

msgctxt "224"
msgid "Okay, here you go. Have fun!"
msgstr "Perfetto, ecco a te. Divertiti!"

msgctxt "248"
msgid "I'll take 1,000 tags."
msgstr "Prendo 1.000 gettoni."

msgctxt "272"
msgid "Okay, here you go. Have fun!"
msgstr "Perfetto, ecco a te. Divertiti!"

msgctxt "296"
msgid "Not now, thanks."
msgstr ""

msgctxt "308"
msgid "Well, all right. But I hope you'll buy some next time."
msgstr "Beh, va bene. Ma spero che la prossima volta ne prenderai un po'."

msgctxt "320"
msgid ""
"Hey, you don't have enough to pay for that! Make sure you\r\n"
"have some more money next time."
msgstr ""

msgctxt "332"
msgid "Buy 50 Tags for 5,000 Yen"
msgstr "Compra 50 Gettoni per 5.000 Yen"

msgctxt "344"
msgid "Buy 100 Tags for 10,000 Yen"
msgstr "Compra 100 gettoni a 10.000 Yen"

msgctxt "356"
msgid "Buy 1,000 Tags for 100,000 Yen"
msgstr "Acquista 1.000 gettoni per 100.000 Yen"

