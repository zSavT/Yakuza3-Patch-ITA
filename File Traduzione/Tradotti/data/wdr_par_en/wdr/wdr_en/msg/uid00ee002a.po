msgid "Hello. How are you feeling today?"
msgstr "Ciao. Come ti senti oggi?"

msgctxt "104"
msgid "Uncle Kaz, I kinda want a <Color:8>Tauriner<Color:Default>..."
msgstr "Zio Kaz, ho un po' voglia di un <Color:8>Tauriner<Color:Default>..."

msgctxt "116"
msgid "(Haruka wants me to get her a <Color:8>Tauriner<Color:Default>...)"
msgstr ""
"(Haruka vuole che io le procuri un <Color:8>Tauriner<Color:Default>...)"

msgctxt "140"
msgid "Aww, I wanted a <Color:8>Tauriner<Color:Default>..."
msgstr "Ah, uffa, volevo un <Color:8>Tauriner<Color:Default>..."

msgctxt "152"
msgid "Thank you. I hope you'll buy something next time."
msgstr "Grazie. Spero che la prossima volta comprerai qualcosa."

msgctxt "176"
