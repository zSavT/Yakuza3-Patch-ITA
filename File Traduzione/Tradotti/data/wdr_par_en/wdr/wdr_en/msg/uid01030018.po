msgctxt "240"
msgid "Let's pick a banker, shall we?"
msgstr ""

msgctxt "252"
msgid "I'm the banker, then."
msgstr ""

msgctxt "264"
msgid "How much will you bet?"
msgstr "Quanto vuoi puntare?"

msgctxt "276"
msgid "Let's start..."
msgstr "Si parte!"

msgctxt "288"
msgid "It's my turn."
msgstr "È il mio turno."

msgctxt "300"
msgid "(This line signifies failure.)"
msgstr "(Questa riga indica fallimento.)"

msgctxt "312"
msgid "Let's settle up."
msgstr "Saldiamo i conti."

msgctxt "324"
msgid "You're the banker."
msgstr "Sei il banchiere."

msgctxt "336"
msgid "Time to change the banker."
msgstr "Si cambia il banco."

msgctxt "348"
msgid "Play again?"
msgstr "Ancora una?"

msgctxt "360"
msgid ""
"I'm tapped out.\r\n"
"It's time I went home."
msgstr ""

msgctxt "372"
msgid ""
"That it for you?\r\n"
"Better luck next time."
msgstr "È finita qui per te? Più fortuna la prossima volta."

msgctxt "1296"
msgid "Broadsword Hide"
msgstr ""
