msgctxt "296"
msgid "I'm fine for now."
msgstr "Per ora sono a posto così."

msgctxt "308"
msgid "I gotcha. I hope you'll buy some next time."
msgstr ""

msgctxt "320"
msgid ""
"Hey, you don't have enough to pay for that! Come back when you got money."
msgstr "Ehi, non hai abbastanza per quello! Torna quando c'hai la grana."

msgctxt "332"
msgid "Buy 50 Tags for 5,000 Yen"
msgstr "Compra 50 Gettoni per 5.000 Yen"

