msgctxt "432"
msgid "Welcome to the blackjack table."
msgstr "Benvenuto al tavolo da blackjack."

msgctxt "444"
msgid "Let's begin."
msgstr "Iniziamo."

msgctxt "456"
msgid ""
"Welcome to the blackjack table. Would you like\r\n"
"to play against the house, one-on-one?"
msgstr ""

msgctxt "468"
msgid "Let's begin."
msgstr "Iniziamo."

msgctxt "480"
msgid "Select \"Bet\" or \"Re-Bet\" to place a wager."
msgstr "Scegli \"Punta\" o \"Ripunta\" per puntare."

msgctxt "492"
msgid "I will now deal the cards."
msgstr "Adesso do le carte."

msgctxt "504"
msgid "I pulled a green card, so I'll shuffle the deck."
msgstr ""

msgctxt "516"
msgid "You seem to be short on chips. Please come back soon."
msgstr "Mi sa che sei a corto di fiches. Fatti rivedere presto."

msgctxt "528"
msgid "It's your turn. What would you like to do?"
msgstr "Tocca a te. Cosa vuoi fare?"

msgctxt "540"
msgid "It's a bust. What a shame."
msgstr "Hai sballato. Che peccato."

msgctxt "552"
msgid "It's the dealer's turn. I'll reveal my cards."
msgstr ""

msgctxt "564"
msgid "The total is less than 17, so I'm drawing a card."
msgstr ""

msgctxt "576"
msgid "The dealer's total is 17."
msgstr "Il totale del banco è 17."

msgctxt "588"
msgid "The dealer's total is 18."
msgstr "Il totale del banco è 18."

msgctxt "600"
msgid "The dealer's total is 19."
msgstr "Il totale del mazziere è 19."

msgctxt "612"
msgid "The dealer's total is 20."
msgstr "Il totale del mazziere è 20."

msgctxt "624"
msgid "The dealer's total is 21."
msgstr "Il totale del banco è 21."

msgctxt "636"
msgid "The dealer has blackjack."
msgstr "Il banco ha blackjack."

msgctxt "648"
msgid "The dealer busts."
msgstr "Il banco sballa."

msgctxt "660"
msgid "The dealer's open card is an ace. It could be blackjack."
msgstr "La carta scoperta del banco è un asso. Potrebbe avere blackjack."

msgctxt "672"
msgid "The dealer has blackjack."
msgstr "Il banco ha blackjack."

msgctxt "684"
msgid "It wasn't blackjack. Let's continue with the game."
msgstr ""

msgctxt "696"
msgid "You have blackjack! Congratulations, sir."
msgstr ""

msgctxt "708"
msgid "However, I do as well. Better luck next time."
msgstr ""

msgctxt "720"
msgid "We look forward to seeing you again soon."
msgstr "Non vediamo l'ora di rivederti presto."

msgctxt "732"
msgid ""
"You seem to be short on chips.\r\n"
"We look forward to seeing you again soon."
msgstr ""
