msgctxt "240"
msgid "Right, so let's choose a banker."
msgstr ""

msgctxt "252"
msgid "So I'm the banker, right?"
msgstr "Allora, sono io il banchiere, no?"

msgctxt "264"
msgid "How much are you gonna wager?"
msgstr "Quanto vuoi puntare?"

msgctxt "276"
msgid "Ready to get started?"
msgstr "Pronto per iniziare?"

msgctxt "288"
msgid "It's my turn, right?"
msgstr "Tocca a me, giusto?"

msgctxt "300"
msgid "(This line signifies failure.)"
msgstr "(Questa riga indica fallimento.)"

msgctxt "312"
msgid "Can I settle the bets now?"
msgstr "Posso sistemare le puntate adesso?"

msgctxt "324"
msgid "You're the banker."
msgstr "Sei il banchiere."

msgctxt "336"
msgid "We change the banker, right?"
msgstr "Si cambia il banco, no?"

msgctxt "348"
msgid "You want to play again?"
msgstr "Vuoi giocare di nuovo?"

msgctxt "360"
msgid ""
"Oh man, I'm broke...\r\n"
"Is it okay if I head home?"
msgstr "Mannaggia, sono a secco... Posso filare a casa?"

msgctxt "372"
msgid ""
"You're out of money, right?\r\n"
"Come back when you've got more, eh?"
msgstr ""

msgctxt "1460"
msgid "Beanpole Naoki"
msgstr ""
