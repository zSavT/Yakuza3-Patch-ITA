msgctxt "204"
msgid "(I seriously don't have 350 yen for the taxi...?)"
msgstr "(Ma dico sul serio? Non ho nemmeno 710 yen per il taxi...?)"

msgctxt "216"
msgid "The minimum fare is 350 yen. Where do you want to go?"
msgstr ""

msgctxt "252"
msgid ""
"Are you sure? It's going to cost you somewhere around\r\n"
"30,000 yen to get there."
msgstr ""

msgctxt "276"
msgid "Yeah, take me there."
msgstr ""

msgctxt "288"
msgid "Very well, sir."
msgstr "Molto bene, signore."

msgctxt "300"
msgid ""
"I'm afraid you don't have enough money, sir. Please come again when you do."
msgstr ""
"Mi dispiace, signore, ma non ha abbastanza contanti. La prego di tornare "
"quando li avrà."

