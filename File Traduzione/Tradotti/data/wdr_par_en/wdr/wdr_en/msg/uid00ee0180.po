msgctxt "224"
msgid ""
"Ya need at least 200 tags to play koi-koi. You can buy 'em at the front."
msgstr ""
"Ti servono almeno 200 tag per giocare a koi-koi. Li puoi comprare "
"all'ingresso."

msgctxt "236"
msgid "Hey, buddy! Wanna play koi-koi?"
msgstr "Ehi, socio! Ti va di giocare a koi-koi?"

msgctxt "260"
msgid "Uncle Kaz! Get 800 points in koi-koi!"
msgstr "Zio Kaz! Fai 500 punti a koi-koi!"

msgctxt "272"
msgid "(800 points in koi-koi... Should I give it a go?)"
msgstr "(500 punti a koi-koi... Mi ci butto?)"

msgctxt "284"
msgid "Sure. I'll play."
msgstr "Certo, ci sto."

msgctxt "296"
msgid "You got it! Let's do this!"
msgstr "Ci siamo! Si parte!"

msgctxt "308"
msgid "Good luck, Uncle Kaz!"
msgstr "Buona fortuna, zio Kaz!"

msgctxt "332"
msgid "Not right now."
msgstr "Non adesso."

msgctxt "344"
msgid "I gotcha. Maybe next time."
msgstr "Capito. Magari la prossima volta."

msgctxt "356"
msgid "Aww, man! I wanted to watch you play koi-koi..."
msgstr "Uffa! Volevo guardarti giocare a koi-koi..."

