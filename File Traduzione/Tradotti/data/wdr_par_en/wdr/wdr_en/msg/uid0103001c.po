msgctxt "240"
msgid "Time to choose a banker."
msgstr ""

msgctxt "252"
msgid "I'm the banker."
msgstr "Faccio io il banco."

msgctxt "264"
msgid "How much you gonna wager?"
msgstr "Quanto punti?"

msgctxt "276"
msgid "All right, here goes."
msgstr "Allora, si comincia."

msgctxt "288"
msgid "My turn."
msgstr "Tocca a me."

msgctxt "300"
msgid "(This line signifies failure.)"
msgstr "(Questa riga indica fallimento.)"

msgctxt "312"
msgid "Time to settle up."
msgstr "È ora di saldare i conti."

msgctxt "324"
msgid "You're the banker."
msgstr "Sei il banchiere."

msgctxt "336"
msgid "Let's switch bankers."
msgstr "Cambiamo banchiere."

msgctxt "348"
msgid "You wanna play again?"
msgstr "Vuoi fare un'altra giocata?"

msgctxt "360"
msgid ""
"That's it for me.\r\n"
"Ugh, I'm outta here..."
msgstr "Per me è finita. Bah, io me ne vado..."

msgctxt "372"
msgid ""
"Ya couldn't bet more if ya wanted to.\r\n"
"Come back when you got the cash."
msgstr ""

msgctxt "1332"
msgid "Yutaka the Hyena"
msgstr ""
