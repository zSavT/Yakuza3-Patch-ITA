msgctxt "80"
msgid "Welcome. Have you decided what you would like to order?"
msgstr "Benvenuto. Ha deciso cosa ordinare?"

msgctxt "104"
msgid ""
"Wow, I really want a <Color:8>Strawberry Gelato<Color:Default>! Could you "
"get me one, Uncle Kaz?"
msgstr ""
"Wow, ho proprio voglia di <Color:8>Gelato alla fragola<Color:Default>! Me lo"
" potresti prendere, zio Kaz?"

msgctxt "116"
msgid ""
"(Haruka wants me to get her a <Color:8>Strawberry Gelato<Color:Default>...)"
msgstr ""
"(Haruka vuole che le prenda del <Color:8>Gelato alla "
"fragola<Color:Default>...)"

msgctxt "140"
