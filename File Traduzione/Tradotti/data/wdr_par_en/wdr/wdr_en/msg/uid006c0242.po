msgctxt "124"
msgid ""
"I love shopping! Man, there are so many different things I wanna get..."
msgstr ""

msgctxt "136"
msgid "Is that so?"
msgstr "È così?"

msgctxt "148"
msgid "C'mon, let's go!"
msgstr "Andiamo, dài!"

