msgctxt "64"
msgid "Hi, Kiryu-san! Is everything all right?"
msgstr ""

msgctxt "76"
msgid ""
"I was following a suspicious-looking guy, but\r\n"
"I lost him."
msgstr ""

msgctxt "88"
msgid "Oh, you did...? Don't worry about it, though."
msgstr ""

msgctxt "100"
msgid ""
"Maybe I'm just imagining this whole \"stalker\" thing... and\r\n"
"I wouldn't want to waste any more of your time, Kiryu-san."
msgstr ""

msgctxt "112"
msgid "Here, for your trouble. Thank you so much!"
msgstr ""

msgctxt "124"
msgid "You got <Color:8>10,000 yen<Color:Default>."
msgstr "Hai ottenuto <Color:8>10.000 yen<Color:Default>."

msgctxt "136"
msgid ""
"(I'm still a little worried about her, but if\r\n"
"she says she's okay, I'll leave it at that.)"
msgstr ""

