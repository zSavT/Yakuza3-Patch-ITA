msgctxt "416"
msgid "You win."
msgstr ""

msgctxt "428"
msgid "One of your hands wins."
msgstr "Una delle tue mani ha vinto."

msgctxt "440"
msgid "Both of your hands win."
msgstr "Entrambe le tue mani hanno vinto."

msgctxt "452"
msgid "The house wins against both of your hands."
msgstr ""

msgctxt "464"
msgid ""
"Both of your hands win. One of your hands is a Six-Card\r\n"
"Charlie. Impressive!"
msgstr ""

msgctxt "476"
msgid ""
"Both of your hands win. And both are Six-Card Charlies!\r\n"
"You really have the devil's luck!"
msgstr ""
"Hai vinto con entrambe le mani. Ed entrambe sono dei Six-Card Charlie! Hai "
"proprio una fortuna sfacciata."

msgctxt "488"
msgid ""
"One of your hands wins. Congratulations on your\r\n"
"Six-Card Charlie."
msgstr ""

msgctxt "500"
msgid ""
"You have a Six Card Charlie: you've drawn six cards\r\n"
"without going bust. This means you win automatically."
msgstr ""

msgctxt "512"
msgid "You've succeeded on your insurance bet. Well-placed, sir."
msgstr ""
