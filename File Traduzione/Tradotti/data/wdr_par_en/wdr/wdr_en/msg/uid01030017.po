msgctxt "240"
msgid "First things first, let's pick the banker."
msgstr ""

msgctxt "252"
msgid "Looks like I'm the banker."
msgstr "Mi sa che faccio io il banco."

msgctxt "264"
msgid "Place your bets!"
msgstr "Fate il vostro gioco!"

msgctxt "276"
msgid "Get ready, here she goes!"
msgstr "Attenti, eccola che parte!"

msgctxt "288"
msgid "My turn."
msgstr "Tocca a me."

msgctxt "300"
msgid "(This line signifies failure.)"
msgstr "(Questa riga indica fallimento.)"

msgctxt "312"
msgid "Let's settle up, eh?"
msgstr ""

msgctxt "324"
msgid "You're the banker, pal."
msgstr "Sei tu il banco, compare."

msgctxt "336"
msgid "Time to change up."
msgstr "È ora di cambiare rotta."

msgctxt "348"
msgid "How's one more sound?"
msgstr ""

msgctxt "360"
msgid ""
"Aw, brother, that's all I can take.\r\n"
"Be seein' ya. Next time, yeah?"
msgstr ""

msgctxt "372"
msgid ""
"Heh! You're all cleaned out!\r\n"
"Better save up for next time."
msgstr "Heh! Ti hanno ripulito! Metti via qualche soldo per il prossimo giro."

msgctxt "1484"
msgid "Stormy Minamoto"
msgstr ""
