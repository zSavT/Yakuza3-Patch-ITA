msgctxt "240"
msgid "Let's see who's banker."
msgstr ""

msgctxt "252"
msgid "Cool, I'm the banker."
msgstr "Alla grande, sono il banchiere."

msgctxt "264"
msgid "So how much are you gonna bet?"
msgstr "Allora, quanto scommetti?"

msgctxt "276"
msgid "Let's get down to business!"
msgstr "Andiamo al sodo!"

msgctxt "288"
msgid "My turn!"
msgstr "Tocca a me!"

msgctxt "300"
msgid "(This line signifies failure.)"
msgstr "(Questa riga indica fallimento.)"

msgctxt "312"
msgid "Let's settle."
msgstr "Regoliamo i conti."

msgctxt "324"
msgid "You're banker, bro."
msgstr "Sei il banchiere, socio."

msgctxt "336"
msgid "So we change bankers now."
msgstr "Allora cambiamo banco adesso."

msgctxt "348"
msgid "Want to try it again?"
msgstr ""

msgctxt "360"
msgid ""
"Shit! I'm broke!\r\n"
"I'm outta here!"
msgstr "Merda! Sono al verde! Me ne vado!"

msgctxt "372"
msgid ""
"Whoa, looks like you're broke.\r\n"
"Better luck next time!"
msgstr "Mi sa che sei al verde. Più fortuna la prossima volta!"

msgctxt "1352"
msgid "Strongarm Eddie"
msgstr ""
