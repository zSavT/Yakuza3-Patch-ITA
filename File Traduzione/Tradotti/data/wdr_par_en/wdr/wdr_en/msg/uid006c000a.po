msgctxt "9836"
msgid "......"
msgstr ""

msgctxt "9848"
msgid "An old friend of mine is staying at my apartment right now."
msgstr ""

msgctxt "9860"
msgid "That must be nice."
msgstr ""

msgctxt "9872"
msgid ""
"Yeah, except my friend swears she can sense the presence of ghosts, and even"
