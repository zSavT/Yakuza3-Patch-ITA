msgstr ""

msgctxt "276"
msgid "All right, I'll give it a shot."
msgstr "Va bene, ci provo."

msgctxt "288"
msgid "Yay! Good luck, Uncle Kaz!"
msgstr "Evviva! Buona fortuna, zio Kaz!"

msgctxt "312"
msgid "(Hold on, I don't have any bait.)"
msgstr "(Aspetta un po', non ho nessuna esca.)"

msgctxt "324"
msgid ""
"Huh? You can't get any fish without bait! Guess I'll figure out something "
"else for dinner, then..."
msgstr ""

