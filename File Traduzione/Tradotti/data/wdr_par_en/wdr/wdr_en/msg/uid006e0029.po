msgctxt "120"
msgid ""
"You wanna play a game of mahjong, man? Gotta have 25,000 points on you. You "
"can buy 'em over at the desk."
msgstr ""
"Ti va una partita a mahjong, amico? Ti servono 25.000 punti. Li puoi "
"prendere alla cassa."

msgctxt "132"
msgid "Yo, play some mahjong with us? We'll put up a pretty tough fight."
msgstr ""

msgctxt "144"
msgid "Yeah, I'm feeling lucky today."
msgstr "Ma sì, mi sento fortunato oggi."

msgctxt "156"
msgid "Okay, let's get started, then!"
msgstr "Ok, dai, iniziamo!"

msgctxt "180"
msgid "Not right now."
msgstr "Non adesso."

msgctxt "192"
msgid "Aw, man... Well, come talk to me if you're feeling up to it later."
msgstr "Ah, mannaggia... Beh, vieni a parlarmi se ti va più tardi."

msgctxt "204"
msgid "Play"
msgstr "Gioca"

msgctxt "216"
msgid "Not Now"
msgstr "Non ora"

