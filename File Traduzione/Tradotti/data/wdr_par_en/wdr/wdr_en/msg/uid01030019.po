msgctxt "240"
msgid "Why don't we choose the banker?"
msgstr ""

msgctxt "252"
msgid "I'm the banker."
msgstr "Faccio io il banco."

msgctxt "264"
msgid "How much do you want to put up?"
msgstr "Quanto ci vuoi mettere?"

msgctxt "276"
msgid "Let's start!"
msgstr "Si comincia!"

msgctxt "288"
msgid "Now it's my turn."
msgstr "Adesso tocca a me."

msgctxt "300"
msgid "(This line signifies failure.)"
msgstr "(Questa riga indica fallimento.)"

msgctxt "312"
msgid "Let's settle up."
msgstr "Saldiamo i conti."

msgctxt "324"
msgid "Your turn to be banker."
msgstr "Tocca a te fare il banco."

msgctxt "336"
msgid "Time to change dealers."
msgstr "È ora di cambiare mazziere."

msgctxt "348"
msgid "Wanna try your luck again?"
msgstr "Ti va di ritentare la fortuna?"

msgctxt "360"
msgid ""
"Aw, come on! Looks like I'm out.\r\n"
"I'll catch you next time."
msgstr ""

msgctxt "372"
msgid ""
"Heheheh, guess that's it for you.\r\n"
"Practice some and come on back!"
msgstr ""

msgctxt "1384"
msgid "Fuyumi 456"
msgstr ""
