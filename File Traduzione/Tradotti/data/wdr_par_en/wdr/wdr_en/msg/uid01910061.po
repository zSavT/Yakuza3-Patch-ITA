msgctxt "120"
msgid ""
"(They said the Reaper Tokoyami would be lurking in a place\r\n"
"where there weren't any people around...)"
msgstr ""

msgctxt "132"
msgid ""
"(This is the most deserted area in Kamurocho, but I don't\r\n"
"see anybody wearing a mask.)"
msgstr ""

msgctxt "144"
msgid "Don't move."
msgstr "Non muoverti!"

msgctxt "156"
msgid "If you ever come looking for me again, I'll kill you."
msgstr ""

msgctxt "168"
msgid ""
"If you know what's good for you, you'll stop poking around\r\n"
"in other people's business."
msgstr ""

msgctxt "228"
msgid "(Was that the Reaper Tokoyami?)"
msgstr ""

msgctxt "252"
msgid "Hey, did you see a suspicious-looking man in a mask?"
msgstr ""

msgctxt "264"
msgid "......"
msgstr ""

msgctxt "276"
msgid "I told you to mind your own business."
msgstr ""

msgctxt "288"
msgid "Wait⑬ You were the one who threatened me just now?"
msgstr ""

msgctxt "300"
msgid ""
"Ignore my warning, will you? Then it's time for you to pay\r\n"
"the price."
msgstr ""

msgctxt "2224"
msgid "Kiryu"
msgstr ""

msgctxt "2228"
msgid "Threatening Man"
msgstr "Uomo Minaccioso"

msgctxt "2232"
msgid "Businessman"
msgstr "Uomo d'Affari"

