msgctxt "532"
msgid ""
"Welcome. Here, you can play Texas hold 'em poker. Would you like to play?"
msgstr ""
"Benvenuto. Qui, puoi giocare a Texas hold 'em poker. Ti va di giocare?"

msgctxt "544"
msgid "Sure, I'll play."
msgstr "Certo, ci sto."

msgctxt "556"
msgid "An excellent choice. What stakes would you like to play for?"
msgstr "Ottima scelta. A che puntate vuole giocare?"

msgctxt "568"
msgid "I'll go with the low stakes."
msgstr "Vado con le puntate basse."

msgctxt "592"
msgid "Very good, sir. Please take your seat."
msgstr "Benissimo, signore. Prego, si accomodi."

msgctxt "616"
msgid "You'll need a minimum of 100 chips to play low-stakes poker, sir."
msgstr ""
"Ti serviranno almeno 100 fiches per giocare a poker a puntate basse, "
"signore."

msgctxt "628"
msgid "I'll go with the high stakes."
msgstr "Vado con la posta alta."

msgctxt "652"
msgid "Very good, sir. Please take your seat."
msgstr "Benissimo, signore. Prego, si accomodi."

msgctxt "676"
msgid "You'll need a minimum of 1,000 chips to play high-stakes poker, sir."
msgstr ""
"Ti serviranno un minimo di 1.000 chips per giocare a poker ad alte puntate, "
"signore."

msgctxt "688"
msgid "Not right now."
msgstr "Non adesso."

msgctxt "700"
msgid "Very well. We hope you'll play with us next time."
msgstr "Molto bene. Speriamo che giocherai con noi la prossima volta."

