msgctxt "268"
msgid "It looks like you don't have enough chips to play poker, sir."
msgstr "Sembra che non abbia abbastanza fiches per giocare a poker, signore."

msgctxt "280"
msgid "If you'd like to purchase chips, you can do so at the front desk."
msgstr "Se desideri acquistare fiches, puoi farlo alla cassa."

msgctxt "292"
msgid ""
"Welcome. Here, you can play Texas hold 'em poker. Would you like to play?"
msgstr ""
"Benvenuto. Qui, puoi giocare a Texas hold 'em poker. Ti va di giocare?"

msgctxt "316"
msgid "Uncle Kaz! Get 3,000 points in poker!"
msgstr "Zio Kaz! Fai 5.000 punti a poker!"

msgctxt "328"
msgid "(3,000 points in poker... Should I give it a try?)"
msgstr "(5.000 punti a poker... Ci provo?)"

msgctxt "340"
msgid "All right, I'll play."
msgstr "Va bene, ci sto."

msgctxt "352"
msgid "Very good, sir. Please take your seat."
msgstr "Benissimo, signore. Prego, si accomodi."

msgctxt "364"
msgid "Good luck, Uncle Kaz!"
msgstr "Buona fortuna, zio Kaz!"

msgctxt "388"
msgid "Not right now."
msgstr "Non adesso."

msgctxt "400"
msgid "Very well. We hope you'll play with us next time."
msgstr "Molto bene. Speriamo che giocherai con noi la prossima volta."

msgctxt "412"
msgid "But I wanted you to play poker..."
msgstr "Ma volevo che giocassi a poker..."

msgctxt "424"
msgid "Uncle Kaz! Get 5,000 points in poker!"
msgstr "Zio Kaz! Fai 5.000 punti a poker!"

