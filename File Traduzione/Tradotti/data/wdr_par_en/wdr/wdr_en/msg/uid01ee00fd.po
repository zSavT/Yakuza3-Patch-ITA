msgstr ""

msgctxt "3944"
msgid "I'm not interested. Go find somebody else."
msgstr ""

msgctxt "3956"
msgid ""
"...Oh, okay. Well, you know what? I'm confident you'll change your mind! "
"I'll be waiting here when you decide to invest in the Tuna Fund!"
msgstr ""

msgctxt "3992"
msgid "Hmm... Well, I do like tuna. All right, I'll invest."
msgstr ""

