msgctxt "240"
msgid "First, let's pick the banker."
msgstr ""

msgctxt "252"
msgid "I'm the banker!"
msgstr "Sono il banco!"

msgctxt "264"
msgid "How much you wanna risk?"
msgstr "Quanto vuoi rischiare?"

msgctxt "276"
msgid "All right, here goes!"
msgstr "Allora, si parte!"

msgctxt "288"
msgid "Here we go, my turn!"
msgstr "Eccoci, tocca a me!"

msgctxt "300"
msgid "(This line signifies failure.)"
msgstr "(Questa riga indica fallimento.)"

msgctxt "312"
msgid "Time to settle our bets!"
msgstr "È ora di regolare i conti!"

msgctxt "324"
msgid "You're the banker."
msgstr "Sei il banchiere."

msgctxt "336"
msgid "Time to change bankers."
msgstr "Tempo di cambiare banchieri."

msgctxt "348"
msgid "One more game?"
msgstr "Ancora una partita?"

msgctxt "360"
msgid ""
"Damn, I'm flat-out broke!\r\n"
"Sorry, but I'm out!"
msgstr ""

msgctxt "372"
msgid ""
"What's wrong, wallet a little light?\r\n"
"Better luck next time, buddy!"
msgstr ""

msgctxt "1428"
msgid "Petty Mitsuru"
msgstr ""
