msgid "Welcome. Have you decided what you would like to order?"
msgstr "Benvenuto. Ha deciso cosa ordinare?"

msgctxt "148"
msgid "Uncle Kaz, can I get some <Color:8>Boba Milk Tea<Color:Default>?"
msgstr ""

msgctxt "160"
msgid ""
"(Haruka wants me to get her some <Color:8>Boba Milk Tea<Color:Default>...)"
msgstr ""
"(Haruka vuole che le prenda delle <Color:8>Costolette<Color:Default>...)"

msgctxt "184"
msgid ""
