msgstr ""

msgctxt "196"
msgid "Thank you very much."
msgstr "Grazie mille."

msgctxt "220"
msgid "Thanks, Uncle Kaz! I love this!"
msgstr ""

msgctxt "280"
msgid "Mmm. That was good! Thanks for treating me!"
msgstr "Mmm, era davvero buono! ♥ Grazie per avermi offerto!"

msgctxt "292"
msgid "(Haruka seems happy...)"
msgstr ""

msgctxt "316"
msgid ""
"Nothing says winter like <Color:8>Chocolate Delight<Color:Default>, don't "
"you think? Let's get some so we can warm up!"
msgstr ""

