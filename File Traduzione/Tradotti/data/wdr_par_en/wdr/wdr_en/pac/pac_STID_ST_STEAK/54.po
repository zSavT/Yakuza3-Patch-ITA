msgctxt "176"
msgid "Thanks, Uncle Kaz!"
msgstr "Grazie, zio Kaz!"

msgctxt "188"
msgid "That was delicious!"
msgstr "Era delizioso!"

msgctxt "212"
msgid "But I wanted that..."
msgstr "Ma volevo quello..."

msgctxt "236"
msgid "Uncle Kaz!"
msgstr "Zio Kaz!"

msgctxt "248"
msgid "I want some Fresh Scallops & Prawns!"
msgstr "Voglio delle capesante fresche e dei gamberi!"

msgctxt "272"
msgid "Ooh, what's that smell?"
msgstr "Ooh, cos'è questo profumo?"

msgctxt "284"
msgid ""
"I think it's a <Color:8>Sam's Cut Tenderloin Steak<Color:Default>! Let's get"
" some!"
msgstr ""
"Credo sia una <Color:8>Bistecca di filetto taglio Sam<Color:Default>! "
"Prendiamola!"
