msgctxt "240"
msgid "You're amazing, Uncle Kaz!"
msgstr "Sei incredibile, zio Kaz!"

msgctxt "252"
msgid "You got a ton of chips!"
msgstr "Hai un sacco di fiches!"

msgctxt "288"
msgid "Oh, you were so close!"
msgstr "Oh, c'eri quasi!"

msgctxt "300"
msgid "You just had some bad luck."
msgstr "Hai avuto solo un po' di sfortuna."

msgctxt "312"
msgid "I wanted you to play poker..."
msgstr "Volevo che giocassi a poker..."

msgctxt "360"
msgid "Uncle Kaz!"
msgstr "Zio Kaz!"

msgctxt "372"
msgid ""
"Get 5,000 points\r\n"
"in poker!"
msgstr "Ottieni 5.000 punti a poker!"

