msgctxt "216"
msgid ""
"Line up, please.\r\n"
"One at a time."
msgstr ""
"Mettetevi in fila, per favore.\r\n"
"Uno alla volta."

msgctxt "228"
msgid ""
"Straighten out your\r\n"
"own life first!"
msgstr ""
"Metti prima a posto\r\n"
"la tua vita!"

msgctxt "240"
msgid ""
"Your fate is\r\n"
"predetermined."
msgstr ""
"Il tuo destino è\r\n"
"predeterminato."

msgctxt "252"
msgid ""
"It's because of your\r\n"
"past life..."
msgstr ""
"È a causa della tua\r\n"
"vita passata..."
