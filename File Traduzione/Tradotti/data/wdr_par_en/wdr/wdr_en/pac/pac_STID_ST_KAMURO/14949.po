msgctxt "108"
msgid ""
"（……電話のベル？\r\n"
"　電話ボックスの電話にかかってきてるのか？）"
msgstr ""

msgctxt "120"
msgid "（…………）"
msgstr ""

msgctxt "132"
msgid ""
"（電話に出てみるか。\r\n"
"　ヤツが電話している居場所を掴まないと……）"
msgstr ""

msgctxt "144"
msgid "もしもし……"
msgstr ""

msgctxt "156"
msgid ""
"金も用意できたか……\r\n"
"よほど、大事なものらしいな……これは。"
msgstr ""

msgctxt "168"
msgid ""
"（やはり、背後から聞こえてくる音……\r\n"
"　どこかで聞いたことがある）"
msgstr ""

msgctxt "180"
msgid ""
"これで最後だ……\r\n"
"武器や防具を持たずに、\r\n"
"ミレニアムタワー裏の駐車場まで来い。"
msgstr ""

msgctxt "192"
msgid "……なに？"
msgstr ""

msgctxt "204"
msgid ""
"どうもお前は、危険な感じがするからな。\r\n"
"念のためだよ。"
msgstr ""

msgctxt "216"
msgid ""
"オレの言うとおりにすれば、\r\n"
"お前の大事なものを返してやるよ。"
msgstr ""

msgctxt "240"
msgid ""
"黒フェード\r\n"
"普通のマップ画面へ"
msgstr ""

msgctxt "252"
msgid ""
"（これが最後と言っていたな。\r\n"
"　音を手がかりに、\r\n"
"　電話をしている相手を見つけ出すか……）"
msgstr ""

msgctxt "264"
msgid ""
"（ヤツの言うとおり、\r\n"
"　武器や防具を持たずに、\r\n"
"　ミレニアムタワー裏の駐車場に行くか……だな）"
msgstr ""

msgctxt "276"
msgid "電話に出る"
msgstr ""

msgctxt "288"
msgid "ほうっておく"
msgstr ""