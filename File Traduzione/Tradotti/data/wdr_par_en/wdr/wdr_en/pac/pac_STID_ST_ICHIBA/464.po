msgctxt "64"
msgid ""
"Will you hurry up\r\n"
"and decide already?"
msgstr ""
"Ti vuoi sbrigare\r\n"
"a deciderti una buona volta?"

msgctxt "76"
msgid ""
"Don't keep me\r\n"
"waiting like this."
msgstr ""
"Non farmi\r\n"
"aspettare così."
