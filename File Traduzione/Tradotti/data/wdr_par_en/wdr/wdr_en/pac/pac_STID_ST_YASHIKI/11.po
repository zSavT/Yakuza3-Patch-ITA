msgctxt "144"
msgid ""
"C'mon, Kiryu-chan, do the\r\n"
"thing! <Color:7>Komaki Firearm Flip<Color:Default>!"
msgstr ""

msgctxt "156"
msgid ""
"First, do <Color:7>Komaki Firearm Flip<Color:Default>!\r\n"
"Flip that sucker around!"
msgstr ""

msgctxt "168"
msgid "<Color:7>Komaki Firearm Flip<Color:Default>! Lemme see it!"
msgstr ""

msgctxt "180"
msgid "Next! <Color:7>Dual Short Sword: Sly Wolf<Color:Default>!"
msgstr ""

msgctxt "192"
msgid ""
"Hack 'em up, Kiryu-chan! Use\r\n"
"<Color:7>Dual Short Sword: Sly Wolf<Color:Default>!"
msgstr ""

msgctxt "204"
msgid "Okay, do <Color:7>Dual Short Sword: Sly Wolf<Color:Default>!"
msgstr ""

msgctxt "216"
msgid "Now hit 'em with a <Color:7>Dragon King Essence<Color:Default>!"
msgstr ""

msgctxt "228"
msgid "Alright! Bust out yer <Color:7>Dragon King Essence<Color:Default>!"
msgstr ""

msgctxt "240"
msgid "More! We need more <Color:7>Dragon King Essence<Color:Default>!"
msgstr ""

msgctxt "252"
msgid "I wanna see <Color:7>Essence of Smoking<Color:Default>!"
msgstr ""

msgctxt "264"
msgid ""
"Those moves are smokin' hot!\r\n"
"Show me yer <Color:7>Essence of Smoking<Color:Default>!"
msgstr ""

msgctxt "276"
msgid "Now! <Color:7>Essence of Smoking<Color:Default>! Make it sexy!"
msgstr ""

msgctxt "288"
msgid ""
"Use <Color:7>Essence of Dagger near a wall<Color:Default>! Just\r\n"
"like yer friendly neighborhood Majima!"
msgstr ""

msgctxt "300"
msgid ""
"Pull off <Color:7>Essence of Dagger near a wall<Color:Default> if\r\n"
"ya really wanna melt my heart, Kiryu-chan!"
msgstr ""

msgctxt "312"
msgid ""
"Finish it! Use <Color:7>Essence of Dagger near a wall<Color:Default>\r\n"
"and shank, shank, shank yer way to victory!"
msgstr ""

msgctxt "324"
msgid ""
"Last one, Kiryu-chan! Show 'em what\r\n"
"a real <Color:7>Essence of Head Bashing<Color:Default> is!"
msgstr ""

msgctxt "336"
msgid ""
"Nothing wraps up a beating like a good\r\n"
"old-fashioned <Color:7>Essence of Head Bashing<Color:Default>!"
msgstr ""

msgctxt "348"
msgid ""
"And now for the grand finale! Give 'em\r\n"
"a heartfelt <Color:7>Essence of Head Bashing<Color:Default>!"
msgstr ""
