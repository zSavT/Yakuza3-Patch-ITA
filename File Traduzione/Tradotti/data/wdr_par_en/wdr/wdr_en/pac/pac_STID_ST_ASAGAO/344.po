msgctxt "108"
msgid "That dress was so cute!"
msgstr "Quel vestito era così carino!"

msgctxt "120"
msgid ""
"The ribbon was\r\n"
"my favorite part!"
msgstr ""
"Il fiocco era\r\n"
"il dettaglio più bello!"

msgctxt "132"
msgid ""
"He's always getting\r\n"
"in trouble with the teacher."
msgstr ""
"Si fa sempre sgridare\r\n"
"dall'insegnante."

msgctxt "144"
msgid "Like, every day."
msgstr "Praticamente ogni giorno."
