msgctxt "128"
msgid "<Color:7>Throw<Color:Default> him, Dragon!"
msgstr "<Color:7>Lancialo<Color:Default>, Dragon!"

msgctxt "140"
msgid ""
"C'mon, c'mon, c'mon!\r\n"
"<Color:7>Chuck<Color:Default> him out of the ring!"
msgstr ""
"Dai, dai, dai!\r\n"
"<Color:7>Sbattilo<Color:Default> fuori dal ring!"

msgctxt "152"
msgid "<Color:7>Toss<Color:Default> him around!"
msgstr "<Color:7>Sbattilo<Color:Default> a destra e a manca!"

msgctxt "164"
msgid ""
"Go, Dragon Mask! Give him\r\n"
"a Dragon Butt Kicking!"
msgstr ""
"Vai, Dragon Mask! Fagli\r\n"
"il sedere a strisce alla Dragon!"

msgctxt "176"
msgid "I'm rooting for you, Ricky Mask!"
msgstr "Faccio il tifo per te, Ricky Mask!"

msgctxt "188"
msgid "Get a running start!"
msgstr ""

msgctxt "200"
msgid "Now! Hit him with a <Color:7>dropkick<Color:Default>!"
msgstr "Ora! Colpiscilo con un <Color:7>dropkick<Color:Default>!"

msgctxt "212"
msgid "It's <Color:7>dropkick<Color:Default> o'clock!"
msgstr "È l'ora del <Color:7>dropkick<Color:Default>!"

msgctxt "224"
msgid "Watch out, Dragon!"
msgstr "Attento, Dragon!"

msgctxt "236"
msgid "Don't let up, Ricky!"
msgstr ""

msgctxt "248"
msgid ""
"I wanna see you win,\r\n"
"Ricky Mask!"
msgstr ""

msgctxt "260"
msgid "Unmask him, Ricky!"
msgstr ""

msgctxt "272"
msgid ""
"No retreat, no surrender!\r\n"
"Let's go, Ricky Mask!"
msgstr ""

msgctxt "284"
msgid ""
"It's time to give him\r\n"
"<Color:7>dropkick<Color:Default> part two!"
msgstr ""

msgctxt "296"
msgid ""
"Wind up and run\r\n"
"for another <Color:7>dropkick<Color:Default>!"
msgstr ""

msgctxt "308"
msgid ""
"Run at him!\r\n"
"<Color:7>Dropkick<Color:Default> him in the face!"
msgstr ""

msgctxt "320"
msgid ""
"That's it, Dragon!\r\n"
"You got this!"
msgstr ""

msgctxt "332"
msgid ""
"Yeahhhh!\r\n"
"A <Color:7>special move<Color:Default>!"
msgstr ""

msgctxt "344"
msgid ""
"I wanna see a Dragon\r\n"
"<Color:7>special move<Color:Default>! Pleeease!"
msgstr ""
"Voglio vedere una <Color:7>mossa speciale<Color:Default>!\r\n"
"Per favooore!"

msgctxt "356"
msgid ""
"Smack him around\r\n"
"with a <Color:7>special move<Color:Default>!"
msgstr ""

msgctxt "368"
msgid ""
"Dragon Mask, he's our man!\r\n"
"If he can't do it, no one can!"
msgstr ""
"Dragon Mask è il nostro campione!\r\n"
"Se non ci riesce lui, non ci riesce nessuno!"
