msgctxt "160"
msgid ""
"Uncle Kaz!\r\n"
"<Color:7>Komaki Tiger Drop<Color:Default>!"
msgstr ""
"Zio Kaz!\r\n"
"<Color:7>Tiger Drop Komaki<Color:Default>!"

msgctxt "172"
msgid ""
"Now!\r\n"
"<Color:7>Komaki Tiger Drop<Color:Default>!"
msgstr ""
"Ora!\r\n"
"<Color:7>Tiger Drop Komaki<Color:Default>!"

msgctxt "184"
msgid "Now use a <Color:7>Komaki Tiger Drop<Color:Default>!"
msgstr "Ora usa un <Color:7>Caduta della Tigre di Komaki<Color:Default>!"

msgctxt "196"
msgid ""
"You can do it,\r\n"
"Uncle Kaz!"
msgstr ""
"Puoi farcela,\r\n"
"zio Kaz!"

msgctxt "208"
msgid ""
"Uncle Kaz! <Color:7>Double Finisher<Color:Default>!\r\n"
"Come on, do a <Color:7>Double Finisher<Color:Default>!"
msgstr ""
"Zio Kaz! <Color:7>Doppio Colpo di Grazia<Color:Default>!\r\n"
"Dai, fai un <Color:7>Doppio Colpo di Grazia<Color:Default>!"

msgctxt "220"
msgid ""
"Now! Do a\r\n"
"<Color:7>Double Finisher<Color:Default>!"
msgstr ""
"Ora! Fai un\r\n"
"<Color:7>Doppio Colpo di Grazia<Color:Default>!"

msgctxt "232"
msgid "Now use a <Color:7>Double Finisher<Color:Default>!"
msgstr "Ora usa un <Color:7>Doppio Colpo di Grazia<Color:Default>!"

msgctxt "244"
msgid ""
