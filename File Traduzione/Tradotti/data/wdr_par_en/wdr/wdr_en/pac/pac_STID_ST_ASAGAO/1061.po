"Usa un <Color:7>Dropkick<Color:Default>!\r\n"
"<Color:7>Dropkick<Color:Default>, dai!"

msgctxt "292"
msgid ""
"That's it,\r\n"
"Uncle Kaz!"
msgstr ""
"Grande,\r\n"
"zio Kaz!"

msgctxt "304"
msgid "<Color:7>Komaki Cat-Like Reflexes<Color:Default>!"
msgstr "Fammi vedere i <Color:7>Riflessi felini di Komaki<Color:Default>!"

