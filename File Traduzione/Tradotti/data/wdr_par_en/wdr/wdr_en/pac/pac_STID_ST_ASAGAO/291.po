msgctxt "212"
msgid ""
"Sit! Sit!\r\n"
"C'mon!"
msgstr ""
"Seduto! Seduto!\r\n"
"Dai!"

msgctxt "224"
msgid "Sit! Sit, Mame!"
msgstr "Seduto! Seduto, Mame!"

msgctxt "236"
msgid ""
"Turn around!\r\n"
"Go in circles!"
msgstr ""
"Gira!\r\n"
"Gira in tondo!"

msgctxt "248"
msgid ""
"Fetch! Go get\r\n"
"it, Mame!"
msgstr ""
"Riporta! Vai a\r\n"
"prenderlo, Mame!"

msgctxt "260"
msgid ""
"Mame! You're doing\r\n"
"it totally wrong!"
msgstr ""
"Mame! Stai sbagliando\r\n"
"tutto!"
