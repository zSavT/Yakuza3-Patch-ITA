msgctxt "64"
msgid ""
"Let's see here... Oh, a\r\n"
"text from Chika-chan."
msgstr ""
"Vediamo un po'... Oh, un\r\n"
"messaggio di Chika-chan."

msgctxt "76"
msgid ""
"Better reply to Miho-chan\r\n"
"as soon as I possibly can."
msgstr ""
"Meglio rispondere a Miho-chan\r\n"
"il prima possibile."

msgctxt "88"
msgid ""
"Guess my plans with\r\n"
"Shiori-chan can wait."
msgstr ""
"Immagino che i programmi con\r\n"
"Shiori-chan possano aspettare."
