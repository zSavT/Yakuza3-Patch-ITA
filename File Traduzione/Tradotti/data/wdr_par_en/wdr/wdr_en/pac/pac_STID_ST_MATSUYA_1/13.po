msgctxt "176"
msgid "That was delicious!"
msgstr "Era delizioso!"

msgctxt "188"
msgid "I hope we come back here some time!"
msgstr "Spero di tornarci prima o poi!"

msgctxt "212"
msgid "But I wanted that..."
msgstr "Ma volevo quello..."

msgctxt "224"
msgid "Oh, all right..."
msgstr "Oh, va bene..."

msgctxt "248"
msgid "Uncle Kaz! Can I have a <Color:8>Demitama Hamburg Meal<Color:Default>?"
msgstr ""
"Zio Kaz! Posso prendere un <Color:8>Pasto hamburger demitama<Color:Default>?"

msgctxt "260"
msgid "Hamburg steak, egg, <Italic>and</Italic> demiglace sauce! Mmm!"
msgstr "Hamburger, uovo <Italic>e</Italic> salsa demi-glace! Mmm!"

msgctxt "272"
msgid "I'm starving!"
msgstr "Sto morendo di fame!"

msgctxt "296"
msgid "Uncle Kaz! I want some <Color:8>Pork Rice<Color:Default>!"
msgstr "Zio Kaz! Voglio del <Color:8>Riso con maiale<Color:Default>!"

msgctxt "308"
msgid "It's hard to go wrong with a classic like this!"
msgstr "Non si sbaglia mai con un classico come questo!"

msgctxt "320"
msgid "I'm starving!"
msgstr "Sto morendo di fame!"
