msgctxt "268"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "289"
msgid "Check Out"
msgstr "Conto"

msgctxt "299"
msgid "Order"
msgstr "Ordina"

msgctxt "305"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "326"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "358"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "393"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "421"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "441"
msgid "Okay. That comes to %s."
msgstr "Va bene. Il totale è di %s."

msgctxt "465"
msgid ""
"This set includes a regular Smile Burger, fries, and a \n"
"drink. Made to go."
msgstr ""
"Questo set include un normale Smile Burger, patatine e una bevanda. Da "
"asporto."

msgctxt "540"
msgid ""
"This set comes with a Smile Cheeseburger, fries, and\n"
"a drink. Made to go."
msgstr ""
"Questo set include uno Smile Cheeseburger, patatine e una bevanda. Da "
"asporto."

msgctxt "614"
msgid ""
"A Teriyaki Smile Burger with special sauce, fries, and\n"
"a drink. Made to go."
msgstr ""
"Uno Smile Burger Teriyaki con salsa speciale, patatine e una bevanda. Da "
"asporto."

msgctxt "690"
msgid ""
"As advertised, a King Smile Burger, fries, and a drink \n"
"come with this set. Made to go."
msgstr ""

msgctxt "778"
msgid ""
"A distinctly Okinawan Goya Burger Set. The slight \n"
"bitterness is addictive. Made to go."
msgstr ""

msgctxt "866"
msgid ""
"A distinctly Okinawan Soki Burger Set. The tender\n"
"pork ribs transform this burger into something\n"
"amazing. Made to go."
msgstr ""

msgctxt "984"
msgid ""
"A Pig's Feet Burger set containing top-quality gelatin.\n"
"Made to go."
msgstr ""

msgctxt "1052"
msgid ""
"The sea grapes pop in your mouth, making a unique \n"
"and flavorful experience. Made to go."
msgstr ""
"L'uva di mare scoppietta in bocca, regalando un'esperienza unica e saporita."

msgctxt "1141"
msgid ""
"A sweet potato shake made with real Okinawan \n"
"sweet potatoes. Made to go."
msgstr ""

msgctxt "1215"
msgid "Thinly sliced, crispy-fried pig's ears. Made to go."
msgstr ""

msgctxt "1267"
msgid ""
"Eight beef patties on a single burger to go. This is our \n"
"finest takeout item."
msgstr ""
