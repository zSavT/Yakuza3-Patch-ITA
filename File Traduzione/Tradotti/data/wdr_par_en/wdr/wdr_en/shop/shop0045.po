msgctxt "248"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "269"
msgid "Check Out"
msgstr "Conto"

msgctxt "279"
msgid "Order"
msgstr "Ordina"

msgctxt "285"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "306"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "338"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "373"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "401"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "421"
msgid "That's %s please."
msgstr ""

msgctxt "439"
msgid ""
"This vintage awamori is a blend of Kamecho Awamori\n"
"and spring water from Mt. Onnadake, giving it a \n"
"muted, mellow flavor."
msgstr ""

msgctxt "561"
msgid ""
"This 22 proof awamori boasts oak barrel aromatics, \n"
"vintage sweetness, and a low alcohol content. It is \n"
"mild and easy to drink."
msgstr ""

msgctxt "690"
msgid ""
"This awamori has been aged for 10 years, giving it a \n"
"mellow flavor and aroma only found in vintage \n"
"liquors."
msgstr ""

msgctxt "800"
msgid ""
"This 25 proof awamori is refreshing and gentle on the\n"
"palate. Its delicate balance of sweet and bitter notes\n"
"makes it a very popular liquor."
msgstr ""

msgctxt "941"
msgid ""
"This awamori is made with the pure waters of Mt.\n"
"Onnadake in the town of Kin, Okinawa. It's known for\n"
"its deep, sweet richness."
msgstr ""

msgctxt "1069"
msgid ""
"This aged, 22 proof awamori sake goes down easy \n"
"due to its low alcohol content."
msgstr ""

msgctxt "1150"
msgid ""
"A one-stop hangover cure. It's full of natural \n"
"ingredients like turmeric."
msgstr ""
"Una cura completa per i postumi della sbornia. È pieno di ingredienti "
"naturali come la curcuma."

msgctxt "1225"
msgid ""
"This 25 proof Zampa awamori is smooth, sweet, and\n"
"refreshing."
msgstr ""

msgctxt "1287"
msgid ""
"This 30 proof Zampa awamori is known for its \n"
"intoxicating aroma and rich, refreshing taste, thanks\n"
"to the black koji fungus used to brew it."
msgstr ""

msgctxt "1429"
msgid ""
"This well-aged Zampa vintage boasts a mellow aroma\n"
"and subtle sweetness. It's quite bold."
msgstr ""
