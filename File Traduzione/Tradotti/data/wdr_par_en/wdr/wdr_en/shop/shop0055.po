msgctxt "168"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "189"
msgid "Check Out"
msgstr "Conto"

msgctxt "199"
msgid "Order"
msgstr "Ordina"

msgctxt "205"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "226"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "258"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "293"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "321"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "341"
msgid "Okay. That comes to %s."
msgstr "Va bene. Il totale è di %s."

msgctxt "365"
msgid ""
"A standard menu item offering the authentic taste of\n"
"Kyushu tonkatsu ramen."
msgstr ""
"Un classico del menù: autentico tonkotsu ramen del \n"
"Kyushu."

msgctxt "441"
msgid ""
"Our famous tonkatsu ramen topped with tender, \n"
"juicy pork belly that'll melt in your mouth."
msgstr ""
"Il nostro celebre ramen tonkotsu, guarnito con pancetta di maiale tenera e "
"succosa che si scioglie in bocca."

msgctxt "533"
msgid ""
"Tasty tonkotsu ramen topped with succulent, thin \n"
"slices of roast pork."
msgstr ""
"Gustoso ramen tonkotsu guarnito con succulente e sottili  fette di maiale "
"arrosto."

msgctxt "605"
msgid ""
"This tonkatsu ramen is topped with spicy roe \n"
"imported straight from Kyushu."
msgstr ""
"Tonkotsu ramen guarnito con uova di merluzzo piccanti importate direttamente"
" dal Kyushu."

msgctxt "682"
msgid ""
"Delicious tonkotsu ramen topped with a soft-boiled\n"
"egg."
msgstr "Squisito ramen tonkotsu con uovo morbido in cima."

msgctxt "738"
msgid ""
"This limited salt ramen is packed with all our\n"
"toppings!"
msgstr ""
