msgctxt "208"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "229"
msgid "Check Out"
msgstr "Conto"

msgctxt "239"
msgid "Order"
msgstr "Ordina"

msgctxt "245"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "266"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "298"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "333"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "361"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "381"
msgid "Let's see. That comes to %s."
msgstr "Vediamo un po'. Il totale è %s."

msgctxt "410"
msgid ""
"Fresh shrimp glazed in spicy cocktail sauce and served\n"
"over lettuce."
msgstr ""

msgctxt "479"
msgid ""
"A connoisseur's delight, with herb butter and fine \n"
"white wine."
msgstr ""

msgctxt "543"
msgid "A medium, juicy tenderloin."
msgstr "Un tenero filetto succoso di medie dimensioni."

msgctxt "571"
msgid "A large, juicy tenderloin grilled to perfection."
msgstr ""

msgctxt "620"
msgid ""
"Teppan-yaki style lobster and tenderloin steak \n"
"cooked right at your table. The sizzle and incredible\n"
"smell will make your mouth water."
msgstr ""

msgctxt "756"
msgid ""
"Fresh scallops and prawns cooked on a hot grill right\n"
"at your table. The exciting sizzle and aroma is sure to\n"
"make your mouth water. "
msgstr ""
"Capesante e gamberoni freschi cotti su una piastra calda direttamente al tuo"
" tavolo. Lo sfrigolio eccitante e l'aroma ti faranno sicuramente venire "
"l'acquolina in bocca."

msgctxt "890"
msgid ""
"Includes a tropical fruit dish, shrimp cocktail, and \n"
"Sam's Cut sirloin steak."
msgstr ""

msgctxt "969"
msgid ""
"Includes a tropical fruit dish, shrimp cocktail, lobster,\n"
"and tenderloin steak."
msgstr ""
