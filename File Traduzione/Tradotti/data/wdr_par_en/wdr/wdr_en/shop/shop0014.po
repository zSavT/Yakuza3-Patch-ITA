msgctxt "348"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "369"
msgid "Check Out"
msgstr "Conto"

msgctxt "379"
msgid "Order"
msgstr "Ordina"

msgctxt "385"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "406"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "438"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "473"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "501"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "521"
msgid "Okay. That comes to %s."
msgstr "Va bene. Il totale è di %s."

msgctxt "545"
msgid ""
"A blend of Mandheling and Brazilian beans with a \n"
"Colombian base."
msgstr "Miscela di caffè Mandheling e brasiliano su base colombiana."

msgctxt "611"
msgid ""
"This is the ultimate cup of coffee, made with rich, \n"
"top-grade coffee beans."
msgstr ""
"La tazza di caffè perfetta, preparata con chicchi di altissima qualità."

msgctxt "688"
msgid ""
"A lot of coffee drinkers love mocha for its bitter, rich \n"
"flavor."
msgstr ""

msgctxt "754"
msgid ""
"Bergamot-scented and brewed with Sri Lankan tea \n"
"leaves from a farm under exclusive contract."
msgstr ""
"Infuso al profumo di bergamotto con foglie di tè dello Sri Lanka da una "
"piantagione in esclusiva."

msgctxt "848"
msgid ""
"Assam tea leaves from a tea farm under our exclusive\n"
"contract has been carefully brewed with creamy\n"
"pasteurized milk from Hokkaido."
msgstr ""
"Foglie di tè Assam da una piantagione in esclusiva, accuratamente infuse con"
" latte cremoso e pastorizzato di Hokkaido."

msgctxt "980"
msgid ""
"This juice is made from 100％ healthy, organic \n"
"tomatoes."
msgstr ""

msgctxt "1039"
msgid ""
"Richly scented tea from the hills of Nuwara Eliya in \n"
"Sri Lanka combined with organic lemon."
msgstr ""
"Tè intensamente profumato dalle colline di Nuwara Eliya in Sri Lanka, "
"abbinato a limone biologico."

msgctxt "1132"
msgid "A creamy parfait loaded with fresh strawberries."
msgstr "Un cremoso parfait guarnito con tante fragole fresche."

msgctxt "1181"
msgid ""
"A sizable parfait loaded with rich, delicious \n"
"chocolate."
msgstr "Un abbondante parfait con cioccolato ricco e delizioso."

msgctxt "1239"
msgid ""
"A popular float made with Uji green tea and creamy\n"
"vanilla ice cream."
msgstr ""
"Un celebre float preparato con tè verde di Uji e cremoso gelato alla "
"vaniglia."

msgctxt "1309"
msgid "Our special shortcake and a drink."
msgstr "La nostra speciale shortcake e una bibita."

msgctxt "1344"
msgid ""
"A fried egg, bacon, toast, and your choice of coffee or\n"
"tea."
msgstr "Uovo fritto, pancetta, toast e caffè o tè a scelta."

msgctxt "1405"
msgid ""
"This set features a bacon, egg, and lettuce sandwich\n"
"on white bread."
msgstr ""
"Questo menu include un sandwich con pancetta, uovo e lattuga su pane bianco."

msgctxt "1474"
msgid "Tuna and cream pasta with a drink."
msgstr "Pasta panna e tonno servita con una bevanda."

msgctxt "1509"
msgid "This beef curry is our special house recipe."
msgstr "Questo curry di manzo è la nostra ricetta speciale della casa."
