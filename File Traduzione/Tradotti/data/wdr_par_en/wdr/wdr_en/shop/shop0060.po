msgctxt "128"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "149"
msgid "Check Out"
msgstr "Conto"

msgctxt "159"
msgid "Order"
msgstr "Ordina"

msgctxt "165"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "186"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "218"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "253"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "281"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "301"
msgid "Let's see. That comes to %s."
msgstr "Vediamo un po'. Il totale è %s."

msgctxt "330"
msgid "My famous soba. It doesn't get any better than this."
msgstr "La mia famosa soba. Non c'è niente di meglio di questo."

msgctxt "383"
msgid ""
"Made with pig's feet simmered for half a day. This \n"
"goes great with Okinawan soba."
msgstr ""

msgctxt "466"
msgid ""
"Tasty Okinawan noodles and tender pork ribs go great\n"
"together."
msgstr ""
"I gustosi noodles di Okinawa e le tenere costine di maiale si sposano alla "
"perfezione."

msgctxt "529"
msgid ""
"Okinawan soba noodles with rafute, cubes of glazed\n"
"pork belly that melt in your mouth."
msgstr ""
