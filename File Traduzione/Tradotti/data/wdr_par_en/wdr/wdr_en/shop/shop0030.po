msgctxt "148"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "169"
msgid "Check Out"
msgstr "Conto"

msgctxt "179"
msgid "Order"
msgstr "Ordina"

msgctxt "185"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "206"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "238"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "273"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "301"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "321"
msgid ""
msgstr ""

msgctxt "322"
msgid ""
"Spaghetti made with eggplant, tomato sauce, and \n"
"savory bacon imported from Denmark."
msgstr ""
"Spaghetti fatti con melanzane, salsa di pomodoro e saporita pancetta "
"importata dalla Danimarca."

msgctxt "407"
msgid ""
"Made with succulent mini shrimp and rich tomato \n"
"cream sauce. A delightful and savory delicacy."
msgstr ""
"Preparati con succulenti gamberetti e una ricca  salsa di panna e pomodoro. "
"Una prelibatezza deliziosa e saporita."

msgctxt "503"
msgid ""
"Carefully simmered, rich meat sauce on our specially \n"
"prepared spaghetti noodles."
msgstr ""
"Sugo di carne ricco e cotto a fuoco lento sui nostri spaghetti preparati "
"appositamente."

msgctxt "585"
msgid ""
"This delicious spaghetti dish is made with authentic \n"
"spicy cod roe from Hakata."
msgstr ""
"Questo delizioso piatto di spaghetti è preparato con autentiche  uova di "
"merluzzo piccanti di Hakata."

msgctxt "666"
msgid ""
"This is our Rich Egg Carbonara, with a tasty soft-boiled\n"
"egg on top and creamy sauce."
msgstr ""
"Questa è la nostra ricca Carbonara all'uovo, con un gustoso uovo poché in "
"cima e una salsa cremosa."
