msgctxt "268"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "289"
msgid "Check Out"
msgstr "Conto"

msgctxt "299"
msgid "Order"
msgstr "Ordina"

msgctxt "305"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "326"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "358"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "393"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "421"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "441"
msgid "Okay. That comes to %s."
msgstr "Va bene. Il totale è di %s."

msgctxt "465"
msgid ""
"Our classic burger set, with a Smile Burger, fries, and\n"
"a drink."
msgstr "Il nostro classico menu, con uno Smile Burger, patatine e una bibita."

msgctxt "530"
msgid ""
"This set includes a Smile Cheeseburger, fries, and a \n"
"drink."
msgstr "Questo set include uno Smile Cheeseburger, patatine e una bevanda."

msgctxt "591"
msgid ""
"This set includes a Teriyaki Smile Burger with special \n"
"sauce, fries, and a drink."
msgstr ""
"Questo set include uno Smile Burger Teriyaki con salsa speciale, patatine e "
"una bevanda."

msgctxt "674"
msgid ""
"As advertised, this set comes with a King Smile \n"
"Burger, fries, and a drink."
msgstr ""
"Come pubblicizzato, questo set include un King Smile Burger, patatine e una "
"bevanda."

msgctxt "751"
msgid ""
"A distinctly Okinawan Goya Burger Set. The slight \n"
"bitterness is addictive. Comes with fries and a drink."
msgstr ""
"Un set Goya Burger tipicamente okinawense. Il suo retrogusto leggermente "
"amaro dà assuefazione. Servito con patatine e una bevanda."

msgctxt "857"
msgid ""
"A distinctly Okinawan Soki Burger Set. The tender \n"
"pork ribs transform this burger into something \n"
"amazing. Comes with fries and a drink."
msgstr ""

msgctxt "995"
msgid ""
"A Pig's Feet Burger set containing top-quality gelatin.\n"
"Comes with fries and a drink."
msgstr ""

msgctxt "1081"
msgid ""
"The sea grapes pop in your mouth, making a unique \n"
"and flavorful experience."
msgstr ""
"L'uva di mare scoppietta in bocca, regalando un'esperienza unica e saporita."

msgctxt "1158"
msgid ""
"A sweet potato shake made with real Okinawan \n"
"sweet potatoes."
msgstr ""

msgctxt "1220"
msgid "Thinly sliced, crispy-fried pig's ears."
msgstr ""

msgctxt "1260"
msgid ""
"Eight beef patties on a single burger. This is our\n"
"finest item."
msgstr ""
