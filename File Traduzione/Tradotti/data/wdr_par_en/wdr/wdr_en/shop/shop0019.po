msgctxt "228"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "249"
msgid "Check Out"
msgstr "Conto"

msgctxt "259"
msgid "Order"
msgstr "Ordina"

msgctxt "265"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "286"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "318"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "353"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "381"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "401"
msgid "Okay. That comes to %s."
msgstr "Va bene. Il totale è di %s."

msgctxt "425"
msgid ""
"Our classic burger set, with a Smile Burger, fries, and\n"
"a drink."
msgstr "Il nostro classico menu, con uno Smile Burger, patatine e una bibita."

msgctxt "490"
msgid ""
"This set includes a Smile Cheeseburger, fries, and a\n"
"drink."
msgstr "Questo set include uno Smile Cheeseburger, patatine e una bevanda."

msgctxt "550"
msgid ""
"This set includes a Teriyaki Smile Burger with special\n"
"sauce, fries, and a drink."
msgstr ""
"Questo set include uno Smile Burger Teriyaki con salsa speciale, patatine e "
"una bevanda."

msgctxt "632"
msgid ""
"As advertised, this set comes with a King Smile \n"
"Burger, fries, and a drink."
msgstr ""
"Come pubblicizzato, questo set include un King Smile Burger, patatine e una "
"bevanda."

msgctxt "709"
msgid ""
"A tasty Tuna Burger with a unique texture. Fries and \n"
"a drink come with this set."
msgstr ""
"Un gustoso Tuna Burger dalla consistenza unica. Patatine  e una bibita sono "
"incluse in questo menu."

msgctxt "791"
msgid "A tender, stewed pork burger with fries and a drink."
msgstr "Un tenero burger di maiale stufato con patatine e una bevanda."

msgctxt "844"
msgid ""
"A Smile Shake made with fresh milk. Sure to put a \n"
"smile on anyone's face."
msgstr ""
"Uno Smile Shake preparato con latte fresco. Metterà sicuramente  un sorriso "
"sul volto di chiunque."

msgctxt "919"
msgid ""
"The golden-fried standard of french fries. Served \n"
"with a smile."
msgstr "Lo standard dorato delle patatine fritte. Servite con un sorriso."

msgctxt "984"
msgid ""
"Eight beef patties on a single burger. This is our\n"
"finest item."
msgstr ""
