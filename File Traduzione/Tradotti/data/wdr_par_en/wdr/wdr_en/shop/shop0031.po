msgctxt "248"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "269"
msgid "Check Out"
msgstr "Conto"

msgctxt "279"
msgid "Order"
msgstr "Ordina"

msgctxt "285"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "306"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "338"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "373"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "401"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "421"
msgid ""
msgstr ""

msgctxt "422"
msgid ""
"Nothing like a swig of grapefruit juice to cool you \n"
"down. Tangy, refreshing, and full of vitamins."
msgstr ""
"Niente come un sorso di succo di pompelmo per rinfrescarsi. Aspro, "
"rinfrescante e pieno di vitamine."

msgctxt "522"
msgid ""
"Refreshing mango juice with that bittersweet \n"
"goodness that only mangos can offer."
msgstr ""

msgctxt "605"
msgid ""
"This hot coffee is made with 100％ Brazilian coffee \n"
"beans for a rich, authentic flavor."
msgstr ""
"Questo caffè caldo è fatto con chicchi di caffè brasiliano al 100% per un "
"sapore ricco e autentico."

msgctxt "695"
msgid ""
"Made with 100％ Brazilian coffee beans. Watered \n"
"down to alleviate the bitterness."
msgstr ""

msgctxt "779"
msgid ""
"A perfect marriage of rich milk and Brazilian coffee \n"
"beans. Truly a match made in heaven."
msgstr ""
"Un connubio perfetto tra latte ricco e chicchi di caffè brasiliano. "
"Un'unione celestiale."

msgctxt "870"
msgid "An classic blend of rich espresso and frothy milk."
msgstr "Una classica miscela di ricco espresso e latte schiumoso."

msgctxt "921"
msgid ""
"A popular drink made with espresso, chocolate, and\n"
"cocoa. Smooth and chocolatey."
msgstr ""
"Una bevanda popolare a base di espresso, cioccolato e cacao. Morbida e "
"cioccolatosa."

msgctxt "1002"
msgid ""
"A rich, refreshing beverage made with fresh milk. \n"
"Posesses a soothing aroma."
msgstr ""

msgctxt "1080"
msgid ""
"Nothing like a refreshing, highly-nutritious glass of \n"
"milk."
msgstr "Niente come un bicchiere di latte rinfrescante e nutriente."

msgctxt "1141"
msgid ""
"Rich, tasty cocoa brewed with specially-selected \n"
"cacao beans."
msgstr ""
"Questo cacao ricco e gustoso è stato preparato con fave di cacao "
"appositamente selezionate."
