msgctxt "148"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "169"
msgid "Check Out"
msgstr "Conto"

msgctxt "179"
msgid "Order"
msgstr "Ordina"

msgctxt "185"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "206"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "238"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "273"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "301"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "321"
msgid ""
msgstr ""

msgctxt "322"
msgid ""
"These boiled soybeans were raised in the great \n"
"outdoors of Hokkaido and are full of protein."
msgstr ""

msgctxt "416"
msgid ""
"This octopus carpaccio is made with soft Hokkaido \n"
"octopus and zesty ponzu sauce."
msgstr ""
"Questo carpaccio di polpo è fatto con morbido polpo di Hokkaido e salsa "
"ponzu piccante."

msgctxt "498"
msgid ""
"Our Jamon Iberico ham is from choice, full-flavored \n"
"Iberico pork that was aged for 24 months."
msgstr ""

msgctxt "593"
msgid ""
"Salad with fresh, zesty tomatoes, mozzarella, and \n"
"homemade dressing for a healthy treat."
msgstr ""
"Insalata con pomodori freschi e saporiti, mozzarella e \n"
"condimento fatto in casa per un pasto sano."

msgctxt "683"
msgid ""
"This Roman pizza is basic Margherita-style with fresh \n"
"tomato sauce and basil."
msgstr ""
"Questa pizza romana è una classica Margherita, preparata con  salsa di "
"pomodoro fresco e basilico."
