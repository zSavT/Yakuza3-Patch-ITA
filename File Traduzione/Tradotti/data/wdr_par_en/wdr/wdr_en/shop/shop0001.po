msgctxt "108"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "129"
msgid "Check Out"
msgstr "Conto"

msgctxt "139"
msgid "Order"
msgstr "Ordina"

msgctxt "145"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "166"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "198"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "233"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "261"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "281"
msgid "That comes to %s."
msgstr "Il totale è di %s."

msgctxt "299"
msgid ""
"This is Temp 1. Its unique sweet flavor sets it apart\n"
"from Temp 2."
msgstr "Questo è Temp 1. Il suo sapore dolce e unico lo distingue dal Temp 2."

msgctxt "366"
msgid ""
"Temp 2 is a popular product of Settsu province, made\n"
"traditionally with their famous water."
msgstr ""
"Il Temp 2 è un prodotto popolare della provincia di Settsu, prodotto "
"tradizionalmente con la loro famosa acqua."

msgctxt "458"
msgid ""
"This strong Temp 3 was made from Satsuma's famous\n"
"sweet potatoes."
msgstr ""
"Questo forte Temp 3 è stato prodotto con le famose patate dolci di Satsuma."
