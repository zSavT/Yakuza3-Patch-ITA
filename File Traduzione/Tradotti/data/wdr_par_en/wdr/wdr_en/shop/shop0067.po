msgctxt "228"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "249"
msgid "Check Out"
msgstr "Conto"

msgctxt "259"
msgid "Order"
msgstr "Ordina"

msgctxt "265"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "286"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "318"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "353"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "381"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "401"
msgid "Okay. That comes to %s."
msgstr "Va bene. Il totale è di %s."

msgctxt "425"
msgid ""
"This set includes a regular Smile Burger, fries, and a\n"
"drink. Made to go."
msgstr ""
"Questo set include un normale Smile Burger, patatine e una bevanda. Da "
"asporto."

msgctxt "499"
msgid ""
"This set comes with a Smile Cheeseburger, fries, and\n"
"a drink. Made to go."
msgstr ""
"Questo set include uno Smile Cheeseburger, patatine e una bevanda. Da "
"asporto."

msgctxt "573"
msgid ""
"A Teriyaki Smile Burger with special sauce, fries, and\n"
"a drink. Made to go."
msgstr ""
"Uno Smile Burger Teriyaki con salsa speciale, patatine e una bevanda. Da "
"asporto."

msgctxt "649"
msgid ""
"As advertised, a King Smile Burger, fries, and a drink \n"
"come with this set. Made to go."
msgstr ""

msgctxt "737"
msgid ""
"A tasty Tuna Burger with a unique texture. Fries and \n"
"a drink come with this set. Made to go."
msgstr ""
"Un gustoso Tuna Burger dalla consistenza unica, patatine e una bevanda sono "
"inclusi in questo set. Da asporto."

msgctxt "831"
msgid ""
"A tender, stewed pork burger with fries and a drink.\n"
"Made to go."
msgstr ""
"Un tenero burger di maiale stufato con patatine e una bevanda. Da asporto."

msgctxt "896"
msgid ""
"A Smile Shake made with fresh milk. Sure to put a \n"
"smile on anyone's face and ready to take anywhere."
msgstr ""

msgctxt "998"
msgid ""
"The golden-fried standard of french fries, served with\n"
"a smile and ready to take anywhere."
msgstr ""

msgctxt "1089"
msgid ""
"Eight beef patties on a single burger to go. This is our\n"
"finest item."
msgstr ""
