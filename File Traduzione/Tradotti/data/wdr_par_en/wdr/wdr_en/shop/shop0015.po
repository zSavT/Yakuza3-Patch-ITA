msgctxt "248"
msgid "Don't Order Anything"
msgstr "Non ordinare nulla"

msgctxt "269"
msgid "Check Out"
msgstr "Conto"

msgctxt "279"
msgid "Order"
msgstr "Ordina"

msgctxt "285"
msgid "(I'm short on cash.)"
msgstr "(Sono a corto di soldi.)  "

msgctxt "306"
msgid "(I can't carry any more stuff.)"
msgstr "(Non posso trasportare altri oggetti.)"

msgctxt "338"
msgid "(I can't handle any more turtles.)"
msgstr "(Non posso trasportare altre tartarughe.)"

msgctxt "373"
msgid "(I didn't choose anything.)"
msgstr "(Non ho scelto niente.)"

msgctxt "401"
msgid "(They're sold out.)"
msgstr "(Sono esauriti.)"

msgctxt "421"
msgid "Will that be all for you?"
msgstr "Sarà tutto per lei?"

msgctxt "447"
msgid "The king of champagnes. Sure to turn heads."
msgstr "Il re degli champagne. Farà sicuramente girare la testa."

msgctxt "491"
msgid "Classy champagne for a classy man."
msgstr "Champagne di classe per un uomo di classe."

msgctxt "526"
msgid ""
"A slightly more premium champagne for the\n"
"discerning customer."
msgstr "Uno champagne leggermente più pregiato per il cliente esigente."

msgctxt "589"
msgid ""
"A middle-of-the-road champagne. Not bad, but\n"
"nothing too special."
msgstr "Uno champagne nella media. Non male, ma niente di speciale."

msgctxt "655"
msgid ""
"A Yamazaki whisky made with carefully-selected,\n"
"mature malts for a flavorful, smooth finish."
msgstr ""
"Un whisky Yamazaki realizzato con malti maturi accuratamente selezionati per"
" un finale saporito e morbido."

msgctxt "748"
msgid "Perilla leaf shochu made in Asahikawa, Hokkaido."
msgstr ""

msgctxt "797"
msgid "A simple draft beer with a nice head of foam."
msgstr "Una semplice birra alla spina con una bella schiuma."

msgctxt "843"
msgid ""
"This is a cocktail of crème de cassis liqueur and \n"
"orange juice."
msgstr "Questo è un cocktail di liquore crème de cassis e  succo d'arancia."

msgctxt "909"
msgid "Plain old orange juice, pulp and all."
msgstr "Semplice succo d'arancia, con polpa e tutto."

msgctxt "947"
msgid ""
"A clean spring-water soju made with premier Korean\n"
"barley."
msgstr ""
"Un soju di acqua di sorgente pulita fatto con orzo coreano di prima qualità."
