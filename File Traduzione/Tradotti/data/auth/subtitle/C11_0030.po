msgctxt "819\t879"
msgid "The hell?"
msgstr "Che diavolo?"

msgctxt "1068\t1218"
msgid "Get outta here! The Tamashiro got\\nnothin' to do with this place!"
msgstr ""

msgctxt "1471\t1539"
msgid "Rikiya! Mikio!"
msgstr ""

msgctxt "2020\t2098"
msgid "You like it here, huh?"
msgstr ""

msgctxt "2173\t2316"
msgid "Funny. Seeing you kids leeching\\noff an adult's generosity..."
msgstr ""

msgctxt "2392\t2471"
msgid "It makes me sick to my stomach."
msgstr ""

msgctxt "2505\t2664"
msgid ""
"You're stray pups, sure. But that alone\\ndoesn't mean you deserve "
"protection."
msgstr ""

msgctxt "2673\t2742"
msgid "I'd rather see you all put down."
msgstr ""

msgctxt "2773\t2929"
msgid "Well, I suppose all of this\\nis that hypocrite Kiryu-san's fault."
msgstr ""

msgctxt "2944\t3005"
msgid "In a way..."
msgstr "In un certo senso."

msgctxt "3032\t3122"
msgid "You're all his victims."
msgstr ""

msgctxt "3646\t3706"
msgid "Smash it."
msgstr ""

msgctxt "4068\t4117"
msgid "No!"
msgstr ""

msgctxt "4118\t4178"
msgid "Outta the way!"
msgstr ""

msgctxt "4293\t4385"
msgid "No! Don't do it!"
msgstr ""

msgctxt "4410\t4470"
msgid "Izumi!"
msgstr ""

msgctxt "4484\t4524"
msgid "Stop!"
msgstr "Fermo!"

msgctxt "4525\t4563"
msgid "Please!"
msgstr "Ti prego!"

msgctxt "4564\t4651"
msgid "Shut it, you fuckin' brat!"
msgstr ""

msgctxt "4652\t4750"
msgid "Please! Stop!"
msgstr "Per favore, fermati!"

msgctxt "4889\t4939"
msgid "Uncle Mikio!"
msgstr ""

msgctxt "4940\t5000"
msgid "Mikio!"
msgstr ""

msgctxt "5020\t5095"
msgid "The hell're you doin', man?"
msgstr ""

msgctxt "5096\t5150"
msgid "I'm not..."
msgstr ""

msgctxt "5171\t5239"
msgid "Letting you do this."
msgstr ""

msgctxt "5273\t5333"
msgid "Mikio!"
msgstr ""

msgctxt "5346\t5428"
msgid "What're you waiting for, coward!?"
msgstr ""

msgctxt "5429\t5507"
msgid "Just crush 'em both!"
msgstr ""

msgctxt "5511\t5571"
msgid "Yes, sir!"
msgstr "Sì, signore!"

msgctxt "5595\t5689"
msgid "Mikio! That's enough!"
msgstr ""

msgctxt "5785\t5845"
msgid "Dammit..."
msgstr "Merda..."

msgctxt "5875\t5945"
msgid "Uncle Mikio!"
msgstr ""

msgctxt "6025\t6161"
msgid "Sorry... I wasn't stronger..."
msgstr ""

msgctxt "6143\t6262"
msgid "Uncle Mikio! Uncle Mikio!"
msgstr ""

msgctxt "6367\t6405"
msgid "No!"
msgstr ""

msgctxt "6406\t6466"
msgid "Mikio!"
msgstr ""

msgctxt "6477\t6537"
msgid "Not so fast."
msgstr "Fermo lì."

msgctxt "6544\t6642"
msgid "We got some unfinished business."
msgstr ""

msgctxt "6643\t6696"
msgid "Tamashiro!"
msgstr ""

msgctxt "6697\t6866"
msgid ""
"Could've sworn you croaked, old man.\\nGuess you're tougher than you look."
msgstr ""

msgctxt "6867\t6927"
msgid "Tamashiro..."
msgstr ""

msgctxt "6928\t7057"
msgid "If it's me you're after...\\nJust end it already."
msgstr ""

msgctxt "7068\t7324"
msgid ""
"But the kids have nothing to do with this!\\nSpare them! Spare this "
"orphanage, please!"
msgstr ""

msgctxt "7415\t7475"
msgid "I'm beggin' you!"
msgstr ""

msgctxt "7502\t7636"
msgid "Oh, but that's not good enough."
msgstr ""

msgctxt "7730\t7869"
msgid "I still haven't forgotten\\nwhat you did to me last year."
msgstr ""

msgctxt "7870\t7943"
msgid "You old fuck!"
msgstr ""

msgctxt "8172\t8232"
msgid "Boss!"
msgstr "Capo!"

msgctxt "8303\t8429"
msgid "We're gonna have a nice long talk later, you and me."
msgstr ""

msgctxt "8436\t8535"
msgid "After we tear this place to the ground, that is."
msgstr ""

msgctxt "8547\t8607"
msgid "What!?"
msgstr "Cosa!?"

msgctxt "8629\t8733"
msgid "C'mon. Bring it in!"
msgstr ""

msgctxt "9087\t9147"
msgid "Stop!"
msgstr "Fermo!"
