msgctxt "35\t83"
msgid "The hell..."
msgstr ""

msgctxt "99\t174"
msgid "Is a guy like you..."
msgstr ""

msgctxt "196\t265"
msgid "Doin' in Okinawa?"
msgstr ""

msgctxt "582\t642"
msgid "You all right, Aniki?"
msgstr ""

msgctxt "658\t706"
msgid "Saki!"
msgstr ""

msgctxt "775\t825"
msgid "Saki..."
msgstr ""

msgctxt "1233\t1305"
msgid "Nakahara-san here..."
msgstr ""

msgctxt "1318\t1469"
msgid ""
"He's been worried sick\\n"
"since you disappeared."
msgstr ""

msgctxt "1529\t1678"
msgid ""
"He was convinced you ran off\\n"
"so you could live with your mom."
msgstr ""

msgctxt "1680\t1757"
msgid "He was miserable."
msgstr ""

msgctxt "1831\t1935"
msgid "So now you have a choice, Saki."
msgstr ""

msgctxt "1937\t2009"
msgid "Nakahara or your mom?"
msgstr ""

msgctxt "2474\t2540"
msgid "I don't want her."
msgstr ""

msgctxt "2542\t2610"
msgid "Just like she doesn't want me."
msgstr ""

msgctxt "2612\t2705"
msgid "You're all a bunch of fucking morons!"
msgstr ""

msgctxt "2754\t2811"
msgid "Don't you get it?"
msgstr ""

msgctxt "2819\t2938"
msgid "This little bitch ruined my life!"
msgstr ""

msgctxt "2947\t3063"
msgid ""
"From the moment she was born,\\n"
"everything was about her!"
msgstr ""

msgctxt "3067\t3196"
msgid ""
"How selfish do you have to be\\n"
"to say that to your own kid!?"
msgstr ""

msgctxt "3198\t3304"
msgid "I'll say what I want! Don't touch me!"
msgstr ""

msgctxt "3428\t3582"
msgid ""
"If you want her weighing you down that bad,\\n"
"just fucking take her!"
msgstr ""

msgctxt "3698\t3806"
msgid "Some mother you are."
msgstr ""

msgctxt "3808\t3882"
msgid "Saying all that in front of your kid..."
msgstr ""

msgctxt "3909\t4010"
msgid "Saki's gonna have it rough with her."
msgstr ""

msgctxt "4019\t4087"
msgid "Saki'll be just fine."
msgstr ""

msgctxt "4220\t4348"
msgid ""
"You've never looked in\\n"
"her sketchbook, have you?"
msgstr ""

msgctxt "4359\t4408"
msgid "No."
msgstr ""

msgctxt "4420\t4462"
msgid "Then open it."
msgstr ""

msgctxt "4708\t4873"
msgid "\"Thank you for protecting me.\""
msgstr ""

msgctxt "4947\t5054"
msgid "Well? There's your answer."
msgstr ""

msgctxt "5096\t5144"
msgid "Saki..."
msgstr ""

msgctxt "5157\t5237"
msgid "She's your daughter now."
msgstr ""

msgctxt "5289\t5375"
msgid "Isn't that right, Saki?"
msgstr ""

msgctxt "5510\t5570"
msgid "Saki..."
msgstr ""

msgctxt "5638\t5698"
msgid "Oh, Saki!"
msgstr ""

msgctxt "5804\t5913"
msgid "Thank you... Thank you so much...!"
msgstr ""

msgctxt "5916\t6014"
msgid "Saki... Saki!"
msgstr ""