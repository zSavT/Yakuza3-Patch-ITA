msgctxt "217\t280"
msgid "Oh man, curry!"
msgstr ""

msgctxt "282\t405"
msgid "Spoons down! You know we don't eat\\nuntil everyone's at the table!"
msgstr ""

msgctxt "407\t457"
msgid "Yeah, yeah..."
msgstr "Sì, sì..."

msgctxt "657\t720"
msgid "Looks like we're all here."
msgstr ""

msgctxt "742\t782"
msgid "Wait."
msgstr "Aspetta."

msgctxt "786\t834"
msgid "Where's Izumi?"
msgstr ""

msgctxt "836\t934"
msgid "Huh? Izumi-chan's still out?"
msgstr ""

msgctxt "986\t1027"
msgid "I don't know."
msgstr "Non lo so..."

msgctxt "1029\t1144"
msgid "Shiro! Weren't you supposed\\nto walk her home from school?"
msgstr ""

msgctxt "1146\t1238"
msgid "I did. She was with me the whole time."
msgstr ""

msgctxt "1270\t1369"
msgid "To be clear, Shiro...\\nyou don't know where she is?"
msgstr ""

msgctxt "1371\t1416"
msgid "Nope."
msgstr "No."

msgctxt "1429\t1499"
msgid "I wonder where she went..."
msgstr ""

msgctxt "1513\t1583"
msgid "It's fine, let's just eat without her!"
msgstr ""

msgctxt "1585\t1691"
msgid "Totally! I'm sure she's okay."
msgstr ""

msgctxt "1693\t1771"
msgid "What do we do, Uncle Kaz?"
msgstr ""

msgctxt "1773\t1857"
msgid "We go find her."
msgstr ""

msgctxt "1869\t1944"
msgid "You all can go ahead without us."
msgstr ""

msgctxt "1960\t2020"
msgid "Yay, finally!"
msgstr ""
