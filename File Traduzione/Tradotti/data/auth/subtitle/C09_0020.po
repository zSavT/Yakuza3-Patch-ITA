msgctxt "253\t444"
msgid ""
"A gaudy place like this has been underneath\\nKamurocho all this time? Who "
"would have thought?"
msgstr ""

msgctxt "474\t579"
msgid "Well? You want to talk to me?"
msgstr ""

msgctxt "578\t636"
msgid "Yes, you must forgive me."
msgstr ""

msgctxt "638\t797"
msgid ""
"I'm afraid my organization is in part to blame\\nfor all the trouble you've "
"been facing."
msgstr ""

msgctxt "798\t876"
msgid "I'm here to hold myself accountable."
msgstr ""

msgctxt "891\t950"
msgid "Accountable...?"
msgstr ""

msgctxt "951\t1011"
msgid "Yes."
msgstr "Sì."

msgctxt "1551\t1611"
msgid "Kanda!?"
msgstr ""

msgctxt "1715\t1839"
msgid "Mine... What is the meaning of this?"
msgstr ""
