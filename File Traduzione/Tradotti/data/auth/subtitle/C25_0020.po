msgctxt "77\t140"
msgid "Hey, Kiryu-san."
msgstr ""

msgctxt "184\t262"
msgid "I just can't..."
msgstr ""

msgctxt "277\t341"
msgid "Take it anymore!"
msgstr ""

msgctxt "386\t440"
msgid "So."
msgstr ""

msgctxt "441\t557"
msgid "Teach me how to do it like a pro?"
msgstr ""

msgctxt "558\t624"
msgid ""
"My boyfriend's such an amateur,\\n"
"you know..."
msgstr ""

msgctxt "625\t671"
msgid "Hey...!"
msgstr ""

msgctxt "672\t732"
msgid "What kind of game are you playing?"
msgstr ""

msgctxt "783\t955"
msgid ""
"Hey, I don't see what the problem is.\\n"
"I've already paid the money, so it's fine!"
msgstr ""

msgctxt "957\t1115"
msgid ""
"So let me indulge myself...\\n"
"by indulging in a man like you!"
msgstr ""

msgctxt "1116\t1216"
msgid ""
"Wait.\\n"
"You paid money for me?"
msgstr ""

msgctxt "1217\t1362"
msgid ""
"Yeah, I already paid Tomoko!\\n"
"Enough for the finest escort in town!"
msgstr ""

msgctxt "1383\t1454"
msgid "You think I'm an escort?"
msgstr ""

msgctxt "1478\t1538"
msgid "Why wouldn't I?"
msgstr ""

msgctxt "1547\t1653"
msgid ""
"I mean, Kiryu-san, isn't that\\n"
"why you're here?"
msgstr ""

msgctxt "1662\t1778"
msgid ""
"Not at all.\\n"
"But I will escort myself out."
msgstr ""

msgctxt "1847\t1944"
msgid "Wait, so you're just gonna get up and go!?"
msgstr ""

msgctxt "1973\t2033"
msgid "What the heck?"
msgstr ""