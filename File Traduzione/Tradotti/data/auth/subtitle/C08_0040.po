msgctxt "296\t356"
msgid "Rikiya!"
msgstr ""

msgctxt "387\t447"
msgid "Aniki!"
msgstr "Capo"

msgctxt "490\t604"
msgid "Oh how I've missed you, Kazuma Kiryu."
msgstr ""

msgctxt "605\t665"
msgid "Lau!"
msgstr ""

msgctxt "666\t843"
msgid "We're overdue for a little talk.\\nSo I thought I'd lure you out."
msgstr ""

msgctxt "864\t941"
msgid "I know what you're after."
msgstr ""

msgctxt "945\t1068"
msgid "He has nothing to do with this!\\nLet him go!"
msgstr ""

msgctxt "1076\t1176"
msgid "You fail to understand."
msgstr ""

msgctxt "1463\t1710"
msgid ""
"My alliance with Hamazaki was forged\\nfor nothing more than revenge. On "
"you."
msgstr ""

msgctxt "1835\t1900"
msgid "And that's why you got Rikiya involved."
msgstr ""

msgctxt "2271\t2432"
msgid "Now, let us put an end to this\\nat last... Kazuma Kiryu!"
msgstr ""
