msgctxt "2081\t2211"
msgid "Fine. Guess I'll have to beat\\nthe answers out of you."
msgstr ""

msgctxt "2212\t2397"
msgid "Try it! You're gonna regret\\never crossin' paths with me!"
msgstr ""

msgctxt "2463\t2579"
msgid "I'm bringin' the heat, Fourth Chairman!"
msgstr ""
