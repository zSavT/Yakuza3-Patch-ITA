msgctxt "357\t524"
msgid ""
"Sorry 'bout this, Fourth Chairman-han.\\nNot a spare seat in the house "
"tonight."
msgstr ""

msgctxt "525\t635"
msgid "Gonna have to respectfully ask ya to leave."
msgstr ""

msgctxt "637\t703"
msgid "I can't do that."
msgstr "Non posso."

msgctxt "725\t841"
msgid "Not before I make you tell me\\nwhat you're up to."
msgstr ""

msgctxt "872\t1138"
msgid ""
"Well, well. That some kinda threat, Chairman-han?\\nCan't let that slide, "
"y'know."
msgstr ""

msgctxt "1140\t1250"
msgid "Sure. If that's how you want to take it."
msgstr ""

msgctxt "1314\t1405"
msgid "Hear that?\\nHe's all yours, boys!"
msgstr ""

msgctxt "1407\t1514"
msgid "Tear these punks to shreds!"
msgstr ""
