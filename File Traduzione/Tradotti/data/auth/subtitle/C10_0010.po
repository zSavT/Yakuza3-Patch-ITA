msgctxt "233.26\t248.4"
msgid "Yoshitaka!"
msgstr ""

msgctxt "254.64\t267.41"
msgid "Yoshitaka!"
msgstr ""

msgctxt "267.71\t276.62"
msgid "Hey, dad!"
msgstr ""

msgctxt "276.92\t323.25"
msgid "Where have you been?\\nDo you know how late it is, young man!?"
msgstr ""

msgctxt "364\t418"
msgid "Um..."
msgstr "Ehm..."

msgctxt "419\t497"
msgid "Me and my friends were playing baseball!"
msgstr ""

msgctxt "498\t685"
msgid "Oh, that's all it was?\\nAnd here I was worrying you'd run away."
msgstr ""

msgctxt "686\t839"
msgid ""
"Hey, and listen to this! I got the best\\ngrade in my class on our test "
"today!"
msgstr ""

msgctxt "840\t1000"
msgid "Wow. I always knew you were a bright kid."
msgstr ""

msgctxt "1090\t1169"
msgid "Guys! Let me play, too!"
msgstr ""

msgctxt "1174\t1281"
msgid "Yeah, right. You don't even have a bat and glove."
msgstr ""

msgctxt "1282\t1391"
msgid "There's no room in our game for poor orphanage trash!"
msgstr ""

msgctxt "1557\t1605"
msgid "Dad!"
msgstr "Papà!"

msgctxt "1606\t1687"
msgid "Get up, please!"
msgstr ""

msgctxt "1688\t1746"
msgid "Yoshitaka..."
msgstr ""

msgctxt "1747\t1794"
msgid "Dad!"
msgstr "Papà!"

msgctxt "1795\t1865"
msgid "Yoshitaka..."
msgstr ""

msgctxt "1866\t1926"
msgid "Listen to me."
msgstr ""

msgctxt "1977\t2099"
msgid "I always knew...\\nyou were the smart one."
msgstr ""

msgctxt "2156\t2226"
msgid "Don't put that brain to waste."
msgstr ""

msgctxt "2280\t2344"
msgid "...Make something of yourself."
msgstr ""

msgctxt "2345\t2405"
msgid "Dad..."
msgstr "Papà..."

msgctxt "2478\t2545"
msgid "I'm so sorry..."
msgstr ""

msgctxt "2595\t2725"
msgid "I can't... be there for you..."
msgstr ""

msgctxt "2760\t2820"
msgid "Dad!"
msgstr "Papà!"

msgctxt "2951\t3003"
msgid "Who is it?"
msgstr "Chi è?"

msgctxt "3004\t3064"
msgid "Katase, sir."
msgstr ""

msgctxt "3166\t3226"
msgid "Come in."
msgstr "Entra pure."

msgctxt "3340\t3400"
msgid "Apologies if I interrupted anything."
msgstr ""

msgctxt "3511\t3610"
msgid "I've booked your flight to Okinawa."
msgstr ""

msgctxt "3611\t3693"
msgid "It leaves from Haneda in an hour and a half."
msgstr ""

msgctxt "3708\t3768"
msgid "Then let's go."
msgstr "E allora andiamo!"

msgctxt "3951\t4011"
msgid "Chairman..."
msgstr "Presidente..."

msgctxt "4013\t4073"
msgid "What is it?"
msgstr "E cioè?"

msgctxt "4125\t4232"
msgid "Never mind.\\nIt's nothing."
msgstr ""

msgctxt "4255\t4411"
msgid "It's just... you've been working\\nyourself awfully hard lately."
msgstr ""

msgctxt "4460\t4564"
msgid "If something happened to you, I..."
msgstr ""

msgctxt "4575\t4703"
msgid "Don't give me that look.\\nI'll be fine."
msgstr ""
