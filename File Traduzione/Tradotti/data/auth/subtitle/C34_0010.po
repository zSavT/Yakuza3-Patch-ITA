msgstr "Questo è per te."

msgctxt "558\t602"
msgid "What is it?"
msgstr "E cioè?"

msgctxt "603\t650"
msgid "\"Shopping Coupon\""
msgstr ""

msgctxt "713\t860"
msgid "Sorry.\\nAnd thanks, for everything."
msgstr ""

msgctxt "870\t927"
msgid "\"Laundry Coupon\""
msgstr ""

msgctxt "949\t1020"
msgid "I've got one, too!"
msgstr ""

msgctxt "1047\t1107"
msgid "You guys..."
msgstr "Ragazzi..."

msgctxt "1126\t1284"
msgid ""
"Everyone's gonna pitch in and help you, Ayako-chan.\\nIt's the least we can "
"do."
msgstr ""

msgctxt "1313\t1383"
msgid "This last one's from me."
msgstr ""

msgctxt "1419\t1541"
msgid "A Homework Coupon?"
msgstr ""

msgctxt "1542\t1659"
msgid "Who'd want that!?\\nYou can barely do your own homework!"
msgstr ""

msgctxt "1660\t1745"
msgid "Yeah, that's just giving her more work!"
msgstr ""

msgctxt "1746\t1848"
msgid "Huh!?"
msgstr "Eh!?"

msgctxt "1849\t1999"
msgid "Thank you, everyone!\\nThank you so much!"
msgstr ""
