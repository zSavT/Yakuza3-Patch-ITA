msgctxt "756\t816"
msgid "It's you."
msgstr "Sei tu..."

msgctxt "1040\t1100"
msgid "What are you doing here?"
msgstr "Che ci fai qui?"

msgctxt "1144\t1242"
msgid "Looks like you're a little late."
msgstr ""

msgctxt "1243\t1336"
msgid "You just missed him."
msgstr ""

msgctxt "1464\t1541"
msgid "If I'd known it would have come to this..."
msgstr ""

msgctxt "1542\t1664"
msgid "I'd have killed you when first we met."
msgstr ""

msgctxt "1665\t1725"
msgid "What?"
msgstr "Cosa?"

msgctxt "1734\t1827"
msgid "Where's Daigo?\\nWhat did you do with him!?"
msgstr ""

msgctxt "1832\t2012"
msgid "If you're looking for Daigo, \\nMine's taken him up to the roof."
msgstr ""

msgctxt "2049\t2109"
msgid "The roof, huh?"
msgstr ""

msgctxt "2278\t2463"
msgid ""
"And let me guess. If I want to get up there,\\nI'll need to go through you."
msgstr ""

msgctxt "2483\t2577"
msgid "You're welcome to try."
msgstr ""

msgctxt "2578\t2760"
msgid "This is the end of the line\\nfor you, Kazuma Kiryu!"
msgstr ""
