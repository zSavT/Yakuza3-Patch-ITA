msgctxt "224\t343"
msgid "Guess this is the end of the line."
msgstr ""

msgctxt "353\t413"
msgid "Yeah."
msgstr "Sì."

msgctxt "449\t567"
msgid "Gonna be real lonesome\\nwithout ya, Kiryu-chan."
msgstr ""

msgctxt "604\t701"
msgid "Take care of Daigo for me."
msgstr ""

msgctxt "706\t766"
msgid "Ya got my word."
msgstr ""

msgctxt "771\t855"
msgid "There's just one thing worryin' me."
msgstr ""

msgctxt "900\t960"
msgid "What's that?"
msgstr "Cos'è?"

msgctxt "1024\t1198"
msgid ""
"If he starts goin' down a weird path,\\ndon't think I'll be able to stop "
"him."
msgstr ""

msgctxt "1200\t1259"
msgid "What do you mean by that?"
msgstr "Cosa intendi?"

msgctxt "1278\t1332"
msgid "Daigo..."
msgstr ""

msgctxt "1335\t1489"
msgid "I mean the sixth chairman.\\nHe's real trustin', just like you."
msgstr ""

msgctxt "1520\t1625"
msgid "Hope he doesn't let anyone\\npull the wool over his eyes."
msgstr ""

msgctxt "1636\t1760"
msgid "Don't worry.\\nDaigo's young, but he's not a fool."
msgstr ""

msgctxt "1927\t1997"
msgid "I should get going."
msgstr "Dovrei andare."

msgctxt "2026\t2150"
msgid "The Tojo Clan's in your hands now."
msgstr ""

msgctxt "2482\t2590"
msgid "The hell'd I get myself into this time?"
msgstr ""

msgctxt "2654\t2712"
msgid "Eh, whatever!"
msgstr "Eh, fa lo stesso."

msgctxt "2714\t2778"
msgid "Goro Majima's..."
msgstr ""

msgctxt "2794\t2872"
msgid "Gonna rule the fuckin' world!"
msgstr ""

msgctxt "2902\t2997"
msgid "Won't be a walk in the park..."
msgstr ""

msgctxt "2999\t3202"
msgid ""
"But hey, Kiryu-chan beat me fair n' square.\\nGuess I gotta go full "
"throttle!"
msgstr ""
