msgid "Mitsuo...\\nYou don't think it's gross?"
msgstr ""

msgctxt "2468\t2528"
msgid "What?"
msgstr "Cosa?"

msgctxt "2573\t2632"
msgid "My burn."
msgstr ""

msgctxt "2665\t2711"
