msgstr ""

msgctxt "3028\t3140"
msgid "That's way weirder than any scar, huh?"
msgstr ""

msgctxt "3208\t3268"
msgid "...Bad joke."
msgstr ""

msgctxt "3394\t3454"
msgid "I'm so sorry."
msgstr "Mi dispiace tanto!"

msgctxt "3462\t3522"
msgid "Huh? For what?"
msgstr ""
