msgid "What was that?"
msgstr "Cosa hai detto?"

msgctxt "1090\t1150"
msgid "Take this!"
msgstr "Prendi questo!"

msgctxt "1180\t1256"
msgid "What's up with him?"
msgstr "Che gli prende?"

msgctxt "1291\t1383"
msgid "Are you hurt, Okada-kun?"
