msgid "It's open."
msgstr ""

msgctxt "1245\t1408"
msgid ""
"Chairman. Regarding today's schedule...\\nWe've received a call from "
"Kashiwagi-san."
msgstr ""

msgctxt "1409\t1523"
msgid "He wants to arrange a meeting\\nof the clan leadership."
msgstr ""

msgctxt "1550\t1597"
msgid "Well all right then."
msgstr "Bene, allora."

msgctxt "1598\t1784"
msgid ""
"And your conference tonight with\\nthose IT venture capitalists, Chairman?"
msgstr ""

msgctxt "1904\t1952"
msgid "Cancel it."
msgstr ""

msgctxt "1966\t2085"
msgid "There's no turning your back\\nwhen headquarters comes knocking."
msgstr ""

msgctxt "2086\t2146"
msgid "Understood, sir."
msgstr ""
