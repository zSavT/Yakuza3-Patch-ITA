msgctxt "127\t173"
msgid "Kiryu-san."
msgstr ""

msgctxt "174\t295"
msgid "I think it's high time\\nwe all learned the truth."
msgstr ""

msgctxt "307\t550"
msgid ""
"Six years ago, Akechi-san was blamed for\\nOda-san's murder. But that's not "
"right, is it?"
msgstr ""

msgctxt "640\t702"
msgid "You want to know the real killer?"
msgstr ""

msgctxt "913\t973"
msgid "It's her!"
msgstr ""

msgctxt "1000\t1167"
msgid "Yuko Kinoshita. You're the one who\\norchestrated Oda-san's death."
msgstr ""
