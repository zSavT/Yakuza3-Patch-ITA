msgctxt "409\t496"
msgid "Been what, two years, Kiryu-san?"
msgstr ""

msgctxt "508\t568"
msgid "Yup."
msgstr "Già."

msgctxt "640\t741"
msgid "The drinks haven't tasted half as\\ngood without you around."
msgstr ""

msgctxt "742\t795"
msgid "Please, take a load off."
msgstr ""

msgctxt "796\t882"
msgid "I'm not sure I have time for that."
msgstr ""

msgctxt "893\t1016"
msgid "You mean because of what Hasebe said?"
msgstr ""

msgctxt "1017\t1137"
msgid "Yeah. I'm worried about Kashiwagi-san."
msgstr ""

msgctxt "1162\t1285"
msgid "I need to get to the Millennium Tower."
msgstr ""

msgctxt "1447\t1560"
msgid "And this is just a simple dispute\\nbetween two of your hosts?"
msgstr ""

msgctxt "1561\t1680"
msgid "Yes. My apologies for the trouble, officer."
msgstr ""

msgctxt "1728\t1859"
msgid "Just give it a bit.\\nKazuki'll be done with them soon enough."
msgstr ""
