msgctxt "555\t615"
msgid "Welcome back, sir!"
msgstr "Bentornato, signore!"

msgctxt "693\t731"
msgid "Chairman."
msgstr "Presidente..."

msgctxt "745\t780"
msgid "What is it?"
msgstr "E cioè?"

msgctxt "782\t874"
msgid "Someone's come seeking audience with you."
msgstr ""

msgctxt "876\t903"
msgid "Who?"
msgstr "Chi è stato?"

msgctxt "905\t952"
msgid "Well..."
msgstr "Beh..."

msgctxt "1041\t1084"
msgid "What!?"
msgstr "Cosa!?"

msgctxt "1094\t1138"
msgid "There's no doubt."
msgstr ""

msgctxt "1142\t1249"
msgid "I didn't believe it myself,\\nbut it's him."
msgstr ""

msgctxt "1322\t1367"
msgid "And where is he?"
msgstr ""

msgctxt "1378\t1478"
msgid "Waiting in your office."
msgstr ""

msgctxt "1520\t1566"
msgid "All right."
msgstr "Va bene."
